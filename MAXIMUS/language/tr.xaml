    <sys:String x:Key="Standalone_LayoutAnalysisDescription">Tanınan metin bloklarının nasıl birleştirileceğini yapılandırın.</sys:String>
    <sys:String x:Key="Standalone_VerticalThresholdHeader">Dikey Bitişiklik Eşik Oranı</sys:String>
    <sys:String x:Key="Standalone_VerticalThresholdDescription" xml:space="preserve">Dikey olarak bitişik metin blokları için birleştirme hassasiyetini kontrol eder.&#10;0.1–0.3: Katı mod — yalnızca birbirine çok yakın satırları birleştirir.&#10;0.5–0.8: Standart mod — bir paragraf içindeki satırları birleştirir.&#10;1.0–3.0: Gevşek mod — birbirinden daha uzak olan metin bloklarını birleştirir.&#10;&gt;5.0: Dikey olarak dağılmış neredeyse tüm metinleri birleştirir.</sys:String>
    <sys:String x:Key="Standalone_HorizontalThresholdHeader">Yatay Bitişiklik Eşik Oranı</sys:String>
    <sys:String x:Key="Standalone_HorizontalThresholdDescription" xml:space="preserve">Yatay olarak bitişik metin blokları için birleştirme hassasiyetini kontrol eder.&#10;0.1–0.3: Katı mod — yalnızca birbirine çok yakın kelimeleri birleştirir.&#10;0.5–0.8: Standart mod — aynı satırdaki kelimeleri birleştirir.&#10;1.0–2.0: Gevşek mod — sütunlar arasında birleştirme yapar.&#10;&gt;5.0: Yatay olarak dağılmış neredeyse tüm metinleri birleştirir.</sys:String>
    <sys:String x:Key="Standalone_LineSpacingThresholdHeader">Satır Sonu Algılama Eşik Oranı</sys:String>
    <sys:String x:Key="Standalone_LineSpacingThresholdDescription" xml:space="preserve">Metinler birleştirilirken satır sonu eklenip eklenmeyeceğini kontrol eder.&#10;0.1–0.2: Katı satır sonları — küçük boşluklar bile yeni satırlara neden olur.&#10;0.3–0.5: Standart satır sonları — çoğu belge için uygundur.&#10;0.8–1.0: Gevşek satır sonları — yalnızca büyük boşluklar yeni satırlara neden olur.&#10;&gt;2.0: Neredeyse hiç satır sonu yok — metin sürekli olarak birleştirilir.</sys:String>
    <sys:String x:Key="Standalone_WordSpacingThresholdHeader">Kelime Boşluğu Algılama Eşik Oranı</sys:String>
    <sys:String x:Key="Standalone_WordSpacingThresholdDescription" xml:space="preserve">Metinler birleştirilirken boşluk eklenip eklenmeyeceğini kontrol eder.&#10;0.1–0.2: Standart boşluk bırakma.&#10;0.3–0.5: Gevşek boşluk bırakma.&#10;&gt;1.0: Neredeyse hiç boşluk eklenmez.</sys:String>

