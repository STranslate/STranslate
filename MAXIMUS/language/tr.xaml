    <sys:String x:Key="General_AutoStartup">Başlangıçta Çalıştır</sys:String>
    <sys:String x:Key="General_AutoStartupDescription">Bilgisayar başladığında yazılımı otomatik olarak başlatır.</sys:String>
    <sys:String x:Key="General_StartMode">Başlangıç Modu</sys:String>
    <sys:String x:Key="General_StartModeDescription">"SkipUACAdmin", UAC (Kullanıcı Hesabı Denetimi) uyarısını atlamak için zamanlanmış bir görev oluşturur.</sys:String>
    <sys:String x:Key="General_HideOnStartup">Sistem Başlangıcında Pencereyi Gizle</sys:String>
    <sys:String x:Key="General_HideOnStartupDescription">STranslate başladıktan sonra arama penceresi sistem tepsisinde gizlenir.</sys:String>
    <sys:String x:Key="General_HideWhenDeactivated">Odak Kaybolduğunda Pencereyi Otomatik Gizle</sys:String>
    <sys:String x:Key="General_WindowPosition">Ana Pencere Konumu</sys:String>
    <sys:String x:Key="General_WindowAlign">Ana Pencerenin Monitördeki Pozisyonu</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatio">Ana Pencere Maksimum Yüksekliği (Ekran Oranı)</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatioDescription">Mevcut monitör çalışma alanının bir oranı olarak ana pencerenin maksimum yüksekliğini kontrol eder (%60-%100).</sys:String>
    <sys:String x:Key="General_DisableGlobalHotkeys">Genel Kısayolları Devre Dışı Bırak</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreen">Tam Ekran Modunda Kısayolları Yoksay</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreenDescription">"Genel Kısayolları Devre Dışı Bırak" seçeneğinden daha düşük önceliğe sahiptir, genellikle oyun senaryolarında kullanılır.</sys:String>
    <sys:String x:Key="General_LanguageDetector">Dil Algılayıcı</sys:String>
    <sys:String x:Key="General_LocalDetector">Yerel Algılama Çince-İngilizce Karakter Oranı</sys:String>
    <sys:String x:Key="General_LocalDetectorDescription">Yalnızca Çince-İngilizce metindeki İngilizce karakterlerin toplam karakterlere oranı için "Yerel Algılama" metoduna uygulanır.</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguage">Varsayılan Kaynak Dil</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguageDescription">Otomatik algılama başarısız olduğunda bu dili kullanır.</sys:String>
    <sys:String x:Key="General_FirstLanguage">Birinci Dil</sys:String>
    <sys:String x:Key="General_FirstLanguageDescription">Herhangi bir çeviri senaryosunda (görsel çeviri dahil) hedef dil Otomatik olarak ayarlandığında ve kaynak dil başka bir dil (ikinci dil dahil) olduğunda, hedef dil birinci dili kullanır.</sys:String>
    <sys:String x:Key="General_SecondLanguage">İkinci Dil</sys:String>
    <sys:String x:Key="General_SecondLanguageDescription">Herhangi bir çeviri senaryosunda (görsel çeviri dahil) hedef dil Otomatik olarak ayarlandığında ve kaynak dil birinci dil olduğunda, hedef dil ikinci dili kullanır.</sys:String>
    <sys:String x:Key="General_HttpTimeout">Zaman Aşımı</sys:String>
    <sys:String x:Key="General_HttpTimeoutDescription">Saniye cinsinden ağ isteği zaman aşımı süresi.</sys:String>
    <sys:String x:Key="General_UseClipboardOutput">Metin Çıkışı için Panoyu Kullan</sys:String>
    <sys:String x:Key="General_UseClipboardOutputDescription">Etkinleştirildiğinde metin çıkışı panodan Ctrl+V kullanır; devre dışı bırakıldığında simüle edilmiş klavye girişi kullanılır (varsayılan).</sys:String>
    <sys:String x:Key="General_TranslateOnPaste">Yapıştırıldığında Çevir</sys:String>
    <sys:String x:Key="General_TranslateOnPasteDescription">Giriş kutusuna metin yapıştırıldığında çeviriyi hemen gerçekleştirir.</sys:String>
    <sys:String x:Key="General_AutoTranslate">Otomatik Çevir</sys:String>
    <sys:String x:Key="General_AutoTranslateDescription">İçerik girilirken belirli bir bekleme süresinden sonra çeviriyi otomatik olarak yürütür.</sys:String>
    <sys:String x:Key="General_InstantTranslate">Anında Çevir</sys:String>
    <sys:String x:Key="General_InstantTranslateDescription">Aşağıdaki eylemler gerçekleştiğinde çeviriyi hemen çalıştırır.</sys:String>
    <sys:String x:Key="General_AutoTranslateButtonVisible">Ana arayüzde otomatik çeviri butonunu göster</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChanged">Komut İstemi (Prompt) Değiştiğinde Otomatik Çevir</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChangedDescription">Yapay zeka çeviri servisleri için komut istemi değiştirildikten hemen sonra çeviriyi yeniden çalıştırır.</sys:String>
    <sys:String x:Key="General_AutoTranslateDelay">Otomatik Çeviri Gecikmesi</sys:String>
    <sys:String x:Key="General_AutoTranslateDelayDescription">İçerik girildikten sonraki bekleme süresi, birim: milisaniye.</sys:String>
    <sys:String x:Key="General_LineBreakHandleType">Satır Sonu İşlemleri</sys:String>
    <sys:String x:Key="General_LineBreakHandleTypeDescription" xml:space="preserve">Kelime seçimi, ekran görüntüsü çevirisi, pano ve sessiz OCR senaryoları için satır sonu işlemeyi içerir.&#10;"Fazladan satır sonlarını kaldır" özelliği esas olarak PDF metin çıkarma, gereksiz satır sonlarını ve cümle sonlarını kaldırma içindir, ancak PDF dışı çıkarmaları etkileyebilir.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleType">Metin Ayırıcı İşlemleri</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleTypeDescription">İngilizce/sayısal tanımlayıcıların içindeki alt çizgileri veya tireleri boşluklara dönüştürür. Varsayılan olarak devre dışıdır.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopes">Ayırıcı İşlem Kapsamı</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopesDescription">Hangi metin yakalama giriş noktalarının ayırıcı işlemeyi uygulayacağını seçin. Seçim yapılmazsa orijinal metin korunur.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeout">Metin Yakalama Zaman Aşımı</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutDescription">Simüle edilmiş kopyalamadan sonra yeni pano metnini sorgulamak için zaman aşımı süresi (milisaniye cinsinden). Metin güncellenir güncellenmez geri döner; yavaş güncellenen PDF uygulamaları için bu değeri artırın.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutPlaceholder">500</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTarget">Kelime Seçimi Başarısız Olduğunda Yedek Eylem</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTargetDescription">Seçilen metin yakalanamadığında, giriş çevirisine geçilmesini mi yoksa yalnızca ana pencerenin gösterilmesini mi seçeceğinizi belirleyin.</sys:String>
    <sys:String x:Key="General_ImageQuality">Görsel Kalitesi</sys:String>
    <sys:String x:Key="General_ImageQualityDescription">Görseller işlenirken kaliteyi ayarlar. Çevrimiçi OCR servisleri görsel boyutunu sınırlayabilir.</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunction">Çift Tıklama Tepsi Fonksiyonu</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunctionDescription">"Hiçbiri" dışında herhangi bir eylemin seçilmesi, tepsiye tek tıklandığında ana pencere görünümünü değiştirme işlevini devre dışı bırakır.</sys:String>
    <sys:String x:Key="General_Language">Dil</sys:String>
    <sys:String x:Key="General_ScreenshotTranslate">Ekran Görüntüsü Çevirisi</sys:String>
    <sys:String x:Key="General_ImageTranslate">Görsel Çevirisi</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslate">Ekran Görüntüsü Çevirisini Göster</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslateDescription">Ana arayüzde "Ekran Görüntüsü Çevirisi" butonunu gösterir. Ekran görüntüsü alır, metni tanır, giriş kutusuna doldurur ve ardından çeviriyi gerçekleştirir.</sys:String>
    <sys:String x:Key="General_ShowImageTranslate">Görsel Çevirisini Göster</sys:String>
    <sys:String x:Key="General_ShowImageTranslateDescription">Ana arayüzde "Görsel Çevirisi" butonunu gösterir. Ekran görüntüsü alır ve doğrudan görsel üzerinde çeviri yapar.</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLines">Ekran Görüntüsü Kılavuz Çizgileri</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLinesDescription">Alanı daha doğru seçmeye yardımcı olmak için ekran görüntüsü sırasında kılavuz çizgilerin gösterilip gösterilmeyeceğini belirler.</sys:String>
    <sys:String x:Key="General_HideNotifyIcon">Bildirim Simgesini Gizle</sys:String>
    <sys:String x:Key="General_ShowScreenshotItemInNotifyIconMenu">Tepsi Menüsünde Ekran Görüntüsü Çevirisini Göster</sys:String>
    <sys:String x:Key="General_ShowImageTranslateItemInNotifyIconMenu">Tepsi Menüsünde Görsel Çevirisini Göster</sys:String>
    <sys:String x:Key="General_ShowOcrItemInNotifyIconMenu">Tepsi Menüsünde Metin Tanımayı Göster</sys:String>
    <sys:String x:Key="General_ShowQrCodeItemInNotifyIconMenu">Tepsi Menüsünde Karekod Okumayı Göster</sys:String>
    <sys:String x:Key="General_ColorTheme">Renk Teması</sys:String>
    <sys:String x:Key="General_ColorThemeDescription">Görüntülenecek renk temasını seçin.</sys:String>
    <sys:String x:Key="General_ColorThemeButtonVisible">Ana arayüzde Renk Teması butonunu göster</sys:String>
    <sys:String x:Key="General_HideInputBox">Giriş Kutusunu Gizle</sys:String>
    <sys:String x:Key="General_HideInputBoxDescription">Giriş kutusunun gizlenip gizlenmeyeceğini belirler.</sys:String>
    <sys:String x:Key="General_HideInputBoxButtonVisible">Ana arayüzde Giriş Kutusunu Gizle butonunu göster</sys:String>
    <sys:String x:Key="General_HideLanguageControl">Dil Seçim Panelini Gizle</sys:String>
    <sys:String x:Key="General_HideLanguageControlDescription">Giriş kutusu gizlendiğinde dil seçim panelinin de gizlenip gizlenmeyeceğini belirler.</sys:String>
    <sys:String x:Key="General_ShowMouseHook">Fare Kancasını (Mouse Hook) Göster</sys:String>
    <sys:String x:Key="General_ShowMouseHookDescription">Ana arayüzde farenin hızlı kelime seçimi özelliğini açıp kapatan simgeyi gösterir.</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigation">Geçmiş Navigasyonunu Göster</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigationDescription">Ana arayüzde ileri/geri geçmiş çeviri gezinme simgelerini görüntüler.</sys:String>
    <sys:String x:Key="General_ShowOcrButton">OCR Butonunu Göster</sys:String>
    <sys:String x:Key="General_ShowOcrButtonDescription">Ana arayüzün başlık çubuğunda OCR butonunu görüntüler.</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitor">Pano İzleyici Butonunu Göster</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitorDescription">Ana arayüzün başlık çubuğunda pano izleyicisini açıp kapatan butonu görüntüler.</sys:String>
    <sys:String x:Key="General_MainHeaderConfig">Ana Başlık Buton Düzeni</sys:String>
    <sys:String x:Key="General_MainHeaderConfigDescription">Üst satır Önizleme, alt satır ise Eylem Havuzudur. Göstermek için havuzdan Önizleme alanına bir öğe sürükleyin, gizlemek için geri sürükleyin ve yeniden sıralamak için Önizleme içinde sürükleyin.</sys:String>
    <sys:String x:Key="General_MainHeaderPreview">Önizleme (Ana Başlık)</sys:String>
    <sys:String x:Key="General_MainHeaderPool">Eylem Havuzu (Gizli)</sys:String>
    <sys:String x:Key="General_MainHeaderShowAll">Tümünü Göster</sys:String>
    <sys:String x:Key="General_MainHeaderHideAll">Tümünü Gizle</sys:String>
    <sys:String x:Key="General_ShowCloseButton">Kapatma Butonunu Göster</sys:String>
    <sys:String x:Key="General_ShowCloseButtonDescription">Ana başlıkta ayarlar butonunun sağında kapatma butonunu görüntüler. Esc tuşu ile aynı şekilde davranır.</sys:String>
    <sys:String x:Key="General_FontSize">Yazı Boyutu</sys:String>
    <sys:String x:Key="General_FontSizeDescription">Sağ tık bağlam menüsü dışındaki tüm öğelerin yazı boyutunu ayarlar</sys:String>
    <sys:String x:Key="General_OutputShowingControl">Çıkış Ekranı Kontrolü</sys:String>
    <sys:String x:Key="General_ShowPascalCase">PascalCase kopyalama butonunu göster</sys:String>
    <sys:String x:Key="General_ShowCamelCase">camelCase kopyalama butonunu göster</sys:String>
    <sys:String x:Key="General_ShowSnakeCase">snake_case kopyalama butonunu göster</sys:String>
    <sys:String x:Key="General_ShowInsert">Metin ekleme butonunu göster</sys:String>
    <sys:String x:Key="General_ShowBackTranslation">Geri çeviri butonunu göster</sys:String>
    <sys:String x:Key="General_ShowPrompt">Komut İstemini (Prompt) Göster</sys:String>
    <sys:String x:Key="General_ShowPromptDescription">Ana arayüzde yapay zeka çeviri servisleri için komut istemi değiştirme butonunun gösterilip gösterilmeyeceğini belirler</sys:String>
    <sys:String x:Key="General_FontFamily">Yazı Tipi Ailesi</sys:String>
    <sys:String x:Key="General_HistoryCount">Geçmiş Kayıt Sayısı</sys:String>
    <sys:String x:Key="General_CopyAfterTranslation">Çeviriden Sonra Kopyala</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationDescription">Yalnızca "Otomatik" olan servisler için geçerlidir</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationNotAutomatic">"Otomatik" olmayan servisler için çeviriden sonra kopyala</sys:String>
    <sys:String x:Key="General_CopyAfterOcr">OCR'dan Sonra Kopyala</sys:String>
    <sys:String x:Key="General_CopyAfterOcrDescription">Tüm metin tanıma senaryolarında, OCR işleminden sonra tanıma sonucunu otomatik olarak kopyalar.</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslate">Ekran görüntüsü çevirisinden sonra girişi etkinleştir</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslateDescription">Açık: ekran görüntüsü çevirisinden sonra ana pencereyi gösterir ve giriş kutusuna odaklanır. Kapalı: ana pencere en üstteyse, odağı çalmadan sonuçları günceller; en üstte olmayan pencereler yine de açılır.</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSource">Eklenti Mağazası CDN Kaynağı</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSourceDescription">Eklenti mağazası verileri için CDN hızlandırma servisini seçin (GitHub doğrudan bağlantısında önbellek gecikmesi yoktur)</sys:String>
    <sys:String x:Key="General_CustomCdnUrl">Özel CDN URL'si</sys:String>
    <sys:String x:Key="General_CustomCdnUrlDescription">Özel CDN URL şablonunu girin, yer tutucu olarak {author}, {repo}, {branch}, {path} kullanın</sys:String>

    <sys:String x:Key="PluginMarketCdnSourceTypeJsDelivr">jsDelivr CDN (Önerilen)</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeGitHubRaw">GitHub Doğrudan</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeCustom">Özel</sys:String>

    <sys:String x:Key="PluginDownloadProxyTypeGitHub">GitHub Doğrudan</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyMirror">mirror.ghproxy.com</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyNet">ghproxy.net</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeCustom">Özel</sys:String>

    <sys:String x:Key="GlobalHotkeys">Genel Kısayollar</sys:String>
    <sys:String x:Key="SoftwareHotkeys">Yazılım İçi Kısayollar</sys:String>
    <sys:String x:Key="Hotkey_OpenSTranslate">STranslate'i Aç</sys:String>
    <sys:String x:Key="Hotkey_OpenSTranslateDescription">STranslate ana arayüzünü göstermek/gizlemek için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_InputTranslate">Giriş Çevirisi</sys:String>
    <sys:String x:Key="Hotkey_InputTranslateDescription">STranslate'i açmak ve giriş çevirisi için içeriği temizlemek için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslate">Seçilen Metni Çevir</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateDescription">Fareyle seçilen metnin çevirisini tetiklemek için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateIsUseCtrlSameC">Metin seçimi çevirisi için Ctrl+C+C kullanılsın mı?</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateTraditional">Geleneksel Kısayol Tuşu</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateByCtrlSameCDescription">Fareyle metni seçtikten sonra metin çevirisi için hızlıca Ctrl+C+C tuşlarına basın.</sys:String>
    <sys:String x:Key="CrosswordTranslateFetchFailed">Seçilen metin yakalanamadı, giriş çevirisine geçildi.</sys:String>
    <sys:String x:Key="CrosswordTranslateFetchFailedShowWindow">Seçilen metin yakalanamadı, ana pencere görünümüne geçildi.</sys:String>
    <sys:String x:Key="Hotkey_MouseHookTranslate">Fare Kancası Çevirisi</sys:String>
    <sys:String x:Key="Hotkey_MouseHookTranslateDescription">Çeviriyi tetiklemek üzere farenin metin seçimini dinlemeyi etkinleştirmek/devre dışı bırakmak için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_ReplaceTranslate">Üzerine Yazarak Çevir</sys:String>
    <sys:String x:Key="Hotkey_ReplaceTranslateDescription">Seçilen metni çevirmek ve orijinal metnin yerine koymak için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_ScreenshotTranslate">Ekran Görüntüsü Çevirisi</sys:String>
    <sys:String x:Key="Hotkey_ScreenshotTranslateDescription">Seçilen bir ekran alanını yakalamak, metni tanımak ve çevirmek için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_ImageTranslate">Görsel Çevirisi</sys:String>
    <sys:String x:Key="Hotkey_ImageTranslateDescription">Ekran görüntüsü almak, bir alan seçmek, metni tanımak ve doğrudan görsel üzerinde çevirmek için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_SilentOcr">Sessiz OCR</sys:String>
    <sys:String x:Key="Hotkey_SilentOcrDescription">Seçilen bir ekran alanını yakalamak, metni tanımak ve panoya kopyalamak için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_SilentTts">Sessiz TTS</sys:String>
    <sys:String x:Key="Hotkey_SilentTtsDescription">Fareyle seçilen metnin konuşma sentezi (seslendirme) için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_Ocr">OCR</sys:String>
    <sys:String x:Key="Hotkey_OcrDescription">Metni tanımak üzere OCR penceresini açmak için kısayol tuşu.</sys:String>
    <sys:String x:Key="Hotkey_ClipboardMonitor">Pano İzleyici Çevirisi</sys:String>
    <sys:String x:Key="Hotkey_ClipboardMonitorDescription">Pano izlemeyi açıp kapatır. Etkinleştirildiğinde, pano değişiklikleri otomatik çeviriyi tetikler.</sys:String>
    <sys:String x:Key="ClipboardMonitorStarted">Pano izleme başlatıldı</sys:String>
    <sys:String x:Key="ClipboardMonitorStopped">Pano izleme durduruldu</sys:String>
    <sys:String x:Key="ClipboardMonitorButtonTooltip">Pano İzleyici Çevirisi</sys:String>
    <sys:String x:Key="Hotkey_CancelOrHide">İptal Et | Arayüzü Gizle</sys:String>
    <sys:String x:Key="Hotkey_CancelOrHideDescription">Bekleyen istekleri iptal eder | Arayüzü gizler. Tüm pencereler için geçerlidir.</sys:String>
    <sys:String x:Key="Hotkey_MainWindow">Ana Pencere Kısayolu</sys:String>
    <sys:String x:Key="Hotkey_Exit">Uygulamadan Çık</sys:String>
