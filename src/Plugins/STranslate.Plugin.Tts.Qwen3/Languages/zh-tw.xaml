<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_BaseUrl">服務地址</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_BaseUrl_Description">本地 qwen3-tts-server 的基礎地址，例如 http://127.0.0.1:9880</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Speaker">說話人</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Speaker_Description">CustomVoice 模型支援的說話人，可存取 {BaseUrl}/speakers 查詢</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Language">語言</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Language_Description">Auto 為自動辨識；也可指定 Chinese / English / Japanese 等</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Instruct">風格指令</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Instruct_Description">可選。用自然語言描述期望的語氣、情緒等。留空則使用預設風格</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Timeout">逾時（秒）</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Support">支援</sys:String>
    <sys:String x:Key="STranslate_Plugin_Tts_Qwen3_Support_Description">本外掛程式基於 Qwen3-TTS 開源專案，點擊連結前往專案首頁</sys:String>

</ResourceDictionary>
