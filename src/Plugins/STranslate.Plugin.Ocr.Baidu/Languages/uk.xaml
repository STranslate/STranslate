<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="STranslate_Plugin_Ocr_Baidu_ApiKey">Ключ API</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_Baidu_SecretKey">Секретний ключ</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_Baidu_Action">Вибір версії</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_Baidu_Action_Description">«Accurate» — версія високої точності, «General» — стандартна, «Basic» — без відомостей про розташування тексту.</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_Baidu_Official">Офіційний сайт</sys:String>
    <sys:String x:Key="STranslate_Plugin_Ocr_Baidu_Official_Description">Перейдіть за посиланням нижче на офіційний сайт, щоб зареєструватися й почати роботу.</sys:String>

</ResourceDictionary>