<ui:ContentDialog
    x:Class="STranslate.Controls.TextPreprocessingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cnvt="clr-namespace:STranslate.Converters"
    xmlns:control="clr-namespace:STranslate.Controls"
    xmlns:core="clr-namespace:STranslate.Core"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
    Title="{DynamicResource General_TextPreprocessing}"
    CloseButtonText="{DynamicResource Cancel}"
    PrimaryButtonText="{DynamicResource Save}"
    DefaultButton="Primary"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <ui:ContentDialog.Resources>
        <sys:Double x:Key="ContentDialogMaxWidth">800</sys:Double>
        <sys:Double x:Key="ContentDialogMinWidth">580</sys:Double>
    </ui:ContentDialog.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12"
            IsEnabled="{Binding IsSaving, Converter={cnvt:BoolInverseConverter}}">
            <TextBlock Text="{DynamicResource General_TextPreprocessingEnable}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <ui:ToggleSwitch IsOn="{Binding IsEnabled, Mode=TwoWay}"
                OnContent="{DynamicResource Enable}" OffContent="{DynamicResource Disable}" />
        </StackPanel>
        <Grid IsEnabled="{Binding IsSaving, Converter={cnvt:BoolInverseConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="240" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                CanUserSortColumns="False" CanUserReorderColumns="False"
                HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{DynamicResource Enable}" Width="68"
                        Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTemplateColumn Header="{DynamicResource General_TextPreprocessingMode}" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="{DynamicResource General_TextPreprocessingPlainText}" Tag="{x:Static core:TextReplacementMode.PlainText}" />
                                    <ComboBoxItem Content="{DynamicResource General_TextPreprocessingRegex}" Tag="{x:Static core:TextReplacementMode.Regex}" />
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{DynamicResource General_TextPreprocessingFind}" Width="*"
                        Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridTextColumn Header="{DynamicResource Translate_TextPreprocessingReplacement}" Width="*"
                        Binding="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}" />
                    <DataGridCheckBoxColumn Header="{DynamicResource Translate_TextPreprocessingIgnoreCase}" Width="90"
                        Binding="{Binding IgnoreCase, UpdateSourceTrigger=PropertyChanged}" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{DynamicResource Add}" Command="{Binding AddRuleCommand}" Margin="0,0,8,0" />
                <control:IconButton Command="{Binding RemoveRuleCommand}"
                    Icon="{x:Static ui:FluentSystemIcons.Delete_20_Regular}" ToolTip="{DynamicResource Delete}" />
                <control:IconButton Command="{Binding MoveRuleUpCommand}"
                    Icon="{x:Static ui:FluentSystemIcons.ChevronUp_20_Regular}" ToolTip="{DynamicResource Translate_TextPreprocessingMoveUp}" />
                <control:IconButton Command="{Binding MoveRuleDownCommand}"
                    Icon="{x:Static ui:FluentSystemIcons.ChevronDown_20_Regular}" ToolTip="{DynamicResource Translate_TextPreprocessingMoveDown}" />
            </StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource General_TextPreprocessingHelp}" TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.7" />
        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,8,0,0"
            Foreground="{DynamicResource {x:Static ui:ThemeKeys.SystemFillColorCriticalBrushKey}}"
            Visibility="{Binding Error, Converter={cnvt:EqualToVisibilityInverseConverter}}" />
    </StackPanel>
</ui:ContentDialog>
