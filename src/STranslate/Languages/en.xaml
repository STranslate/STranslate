    <sys:String x:Key="General_DefaultSourceLanguageDescription">Use this language when auto detection fails.</sys:String>
    <sys:String x:Key="General_FirstLanguage">First Language</sys:String>
    <sys:String x:Key="General_FirstLanguageDescription">When the target language is set to Auto in any translation scenario, and the source language is another language (including the second language), the target language uses the first language.</sys:String>
    <sys:String x:Key="General_SecondLanguage">Second Language</sys:String>
    <sys:String x:Key="General_SecondLanguageDescription">When the target language is set to Auto in any translation scenario, and the source language is the first language, the target language uses the second language.</sys:String>
    <sys:String x:Key="General_HttpTimeout">Timeout</sys:String>
    <sys:String x:Key="General_HttpTimeoutDescription">Network request timeout in seconds.</sys:String>
    <sys:String x:Key="General_UseClipboardOutput">Use Clipboard for Text Output</sys:String>
    <sys:String x:Key="General_UseClipboardOutputDescription">When enabled, text output uses clipboard Ctrl+V; when disabled, simulated keyboard input is used (default).</sys:String>
    <sys:String x:Key="General_TranslateOnPaste">Translate on Paste</sys:String>
    <sys:String x:Key="General_TranslateOnPasteDescription">Execute translation immediately when text is pasted into the input box.</sys:String>
    <sys:String x:Key="General_AutoTranslate">Auto-Translate</sys:String>
    <sys:String x:Key="General_AutoTranslateDescription">Automatically executes translation after a certain waiting time when inputting content.</sys:String>
    <sys:String x:Key="General_InstantTranslate">Instant Translate</sys:String>
    <sys:String x:Key="General_InstantTranslateDescription">Run translation immediately when the following actions occur.</sys:String>
    <sys:String x:Key="General_AutoTranslateButtonVisible">Show automatic translation button on main interface</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChanged">Auto-translate on Prompt Switch</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChangedDescription">Re-run translation immediately after switching prompt for AI translation services.</sys:String>
    <sys:String x:Key="General_IncrementalClearInput">Clear Input on Incremental Translate</sys:String>
    <sys:String x:Key="General_IncrementalClearInputDescription">When enabled (default), the input box is cleared when incremental translation is triggered; selections during the session are still appended. When disabled, the previous content is kept and new selections are appended to it.</sys:String>
    <sys:String x:Key="General_AutoTranslateDelay">Auto-Translate Delay</sys:String>
    <sys:String x:Key="General_AutoTranslateDelayDescription">Waiting time after inputting content, unit: milliseconds.</sys:String>
    <sys:String x:Key="General_LineBreakHandleType">Line Break Handling</sys:String>
    <sys:String x:Key="General_LineBreakHandleTypeDescription" xml:space="preserve">Includes line break handling for word selection, screenshot translation, clipboard, and silent OCR scenarios.&#10;"Remove extra line breaks" is mainly for PDF text extraction, removing redundant line breaks and sentence breaks, but it may affect non-PDF extraction.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleType">Text Separator Handling</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleTypeDescription">Converts underscores or hyphens inside English/numeric identifiers to spaces. Disabled by default.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopes">Separator Handling Scope</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopesDescription">Choose which text capture entry points apply separator handling. No selection keeps original text.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeout">Text Capture Timeout</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutDescription">Timeout for polling new clipboard text after simulated copy, in milliseconds. Returns as soon as text is updated; increase this for PDF apps that update slowly.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutPlaceholder">500</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTarget">Word Selection Failure Fallback</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTargetDescription">When selected text capture fails, choose whether to switch to input translation or only show the main window.</sys:String>
    <sys:String x:Key="General_ImageQuality">Image Quality</sys:String>
    <sys:String x:Key="General_ImageQualityDescription">Adjust the quality when processing images. Online OCR services may limit image size.</sys:String>
