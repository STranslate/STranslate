    <sys:String x:Key="Tts">语音合成</sys:String>
    <sys:String x:Key="Vocabulary">生词本</sys:String>
    <sys:String x:Key="Standalone">独立窗口</sys:String>
    <sys:String x:Key="History">历史</sys:String>
    <sys:String x:Key="Plugins">插件</sys:String>
    <sys:String x:Key="Hotkeys">热键</sys:String>
