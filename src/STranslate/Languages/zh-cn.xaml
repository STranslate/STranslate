    <sys:String x:Key="About">关于</sys:String>

    <!--  // General Page //  -->
    <sys:String x:Key="TimeoutPlaceholder">超时时间（秒）</sys:String>
    <sys:String x:Key="SearchFunction">搜索功能</sys:String>
    <sys:String x:Key="SearchFunctionToolTip">按 Ctrl+F 搜索功能</sys:String>
    <sys:String x:Key="NoResultsFound">未找到结果</sys:String>
    <sys:String x:Key="Function">功能</sys:String>
    <sys:String x:Key="Appearance">外观</sys:String>
    <sys:String x:Key="AutoTranslateEnabled">启用自动翻译</sys:String>
    <sys:String x:Key="AutoTranslateDisabled">禁用自动翻译</sys:String>
    <sys:String x:Key="General_AutoStartup">开机自启</sys:String>
    <sys:String x:Key="General_AutoStartupDescription">电脑启动时软件自动启动。</sys:String>
    <sys:String x:Key="General_StartMode">启动模式</sys:String>
    <sys:String x:Key="General_StartModeDescription">「跳过UAC管理员启动」将创建一个计划任务来跳过UAC弹出窗口。</sys:String>
    <sys:String x:Key="General_HideOnStartup">系统启动时不显示主窗口</sys:String>
    <sys:String x:Key="General_HideOnStartupDescription">STranslate 启动后搜索窗口隐藏在托盘中。</sys:String>
    <sys:String x:Key="General_HideWhenDeactivated">失去焦点时自动隐藏主窗口</sys:String>
    <sys:String x:Key="General_WindowPosition">主窗口位置</sys:String>
    <sys:String x:Key="General_WindowAlign">主窗口在显示器上的位置</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatio">主窗口最大高度（屏幕比例）</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatioDescription">控制主窗口最大高度占当前显示器工作区的比例（60%~100%）。</sys:String>
    <sys:String x:Key="General_DynamicIsland">灵动岛</sys:String>
    <sys:String x:Key="General_DynamicIslandEnabled">启用灵动岛</sys:String>
    <sys:String x:Key="General_DynamicIslandEnabledDescription">取词翻译时以屏幕顶部胶囊展示翻译结果，替代弹出原翻译窗口；双击胶囊可展开原窗口。</sys:String>
    <sys:String x:Key="General_DynamicIslandDuration">自动隐藏时长（秒）</sys:String>
    <sys:String x:Key="General_DynamicIslandDurationDescription">显示翻译结果后，无操作时自动隐藏灵动岛的时间。</sys:String>
    <sys:String x:Key="General_DynamicIslandMaxWidth">最大宽度</sys:String>
    <sys:String x:Key="General_DynamicIslandMaxWidthDescription">灵动岛宽度上限，文本过长时截断显示。</sys:String>
    <sys:String x:Key="General_DynamicIslandHeight">高度</sys:String>
    <sys:String x:Key="General_DynamicIslandHeightDescription">灵动岛胶囊高度。</sys:String>
    <sys:String x:Key="General_DynamicIslandTopMargin">距顶部间距</sys:String>
    <sys:String x:Key="General_DynamicIslandTopMarginDescription">灵动岛距屏幕工作区顶部的距离。</sys:String>
    <sys:String x:Key="General_DisableGlobalHotkeys">禁用全局热键</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreen">全屏模式下忽略热键</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreenDescription">优先级低于「禁用全局热键」一般用于游戏场景</sys:String>
    <sys:String x:Key="General_LanguageDetector">语言检测器</sys:String>
    <sys:String x:Key="General_LocalDetector">本地识别中英字符比例</sys:String>
    <sys:String x:Key="General_LocalDetectorDescription">仅针对「本地识别」中英文情况下英文字符占总字符数的比例</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguage">默认源语言</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguageDescription">当自动检测失败时使用此语言。</sys:String>
    <sys:String x:Key="General_FirstLanguage">第一语言</sys:String>
    <sys:String x:Key="General_FirstLanguageDescription">当任意翻译场景的目标语言设为自动，且源语言为其他语言（包含第二语言）时，目标语言使用第一语言。</sys:String>
    <sys:String x:Key="General_SecondLanguage">第二语言</sys:String>
    <sys:String x:Key="General_SecondLanguageDescription">当任意翻译场景的目标语言设为自动，且源语言为第一语言时，目标语言使用第二语言。</sys:String>
    <sys:String x:Key="General_HttpTimeout">超时时间</sys:String>
    <sys:String x:Key="General_HttpTimeoutDescription">请求网络请求的超时时间，单位：秒。</sys:String>
    <sys:String x:Key="General_UseClipboardOutput">文本输出使用剪贴板</sys:String>
    <sys:String x:Key="General_UseClipboardOutputDescription">开启后将通过剪贴板 Ctrl+V 输出文本；关闭时使用键盘模拟输入（默认）。</sys:String>
    <sys:String x:Key="General_TranslateOnPaste">粘贴立即翻译</sys:String>
    <sys:String x:Key="General_TranslateOnPasteDescription">输入框内粘贴文本立即执行翻译。</sys:String>
    <sys:String x:Key="General_AutoTranslate">自动翻译</sys:String>
    <sys:String x:Key="General_AutoTranslateDescription">输入内容等待一定时间后自动执行翻译。</sys:String>
    <sys:String x:Key="General_InstantTranslate">立即翻译</sys:String>
    <sys:String x:Key="General_InstantTranslateDescription">以下操作触发后将立即执行翻译。</sys:String>
    <sys:String x:Key="General_AutoTranslateButtonVisible">在主界面上显示自动翻译按钮</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChanged">切换提示词后自动翻译</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChangedDescription">切换AI翻译服务的提示词后，立即重新执行翻译。</sys:String>
    <sys:String x:Key="General_IncrementalClearInput">增量翻译时清空输入</sys:String>
    <sys:String x:Key="General_IncrementalClearInputDescription">开启后（默认）触发增量翻译时清空输入框，本次会话内选中文本仍累积追加；关闭后保留旧逻辑，不清空原有内容，直接追加。</sys:String>
    <sys:String x:Key="General_AutoTranslateDelay">自动翻译延时</sys:String>
    <sys:String x:Key="General_AutoTranslateDelayDescription">输入内容等待时间，单位：毫秒。</sys:String>
    <sys:String x:Key="General_LineBreakHandleType">取词换行处理</sys:String>
    <sys:String x:Key="General_LineBreakHandleTypeDescription" xml:space="preserve">包括划词、截图翻译、剪贴板、静默OCR取词场景的换行处理&#10;「移除多余换行」主要针对PDF取词场景，移除多余换行和断句，但是对非PDF取词可能有影响</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleType">取词分隔符处理</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleTypeDescription">将英文/数字标识符中的下划线或中划线转换为空格，默认不处理。</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopes">分隔符处理生效范围</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopesDescription">选择哪些取词入口应用分隔符处理。未选择时保持原文本。</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeout">取词超时时间</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutDescription">模拟复制后轮询剪贴板新文本的超时时间，单位：毫秒。写入成功会立即返回；部分 PDF 软件写入较慢时可适当调高。</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutPlaceholder">500</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTarget">划词取词失败回退目标</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTargetDescription">划词取词失败后，选择回退到输入翻译或仅显示主界面。</sys:String>
    <sys:String x:Key="General_ImageQuality">图片质量</sys:String>
    <sys:String x:Key="General_ImageQualityDescription">处理图片时质量调整，在线OCR服务可能会限制图片大小</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunction">双击托盘程序功能</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunctionDescription">选择除「无操作」的其他操作会禁用托盘单击切换主窗口显示功能</sys:String>
    <sys:String x:Key="General_Language">语言</sys:String>
    <sys:String x:Key="General_ScreenshotTranslate">截图翻译</sys:String>
    <sys:String x:Key="General_ImageTranslate">图片翻译</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslate">显示截图翻译</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslateDescription">在主界面上显示「截图翻译」按钮，截图并识别结果填充到输入框后执行翻译</sys:String>
    <sys:String x:Key="General_ShowImageTranslate">显示图片翻译</sys:String>
    <sys:String x:Key="General_ShowImageTranslateDescription">在主界面上显示「图片翻译」按钮，截图后在图片上进行翻译</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLines">截图辅助线</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLinesDescription">截图时是否显示辅助线，帮助更精确地选择区域。</sys:String>
    <sys:String x:Key="General_HideNotifyIcon">隐藏托盘图标</sys:String>
    <sys:String x:Key="General_ShowScreenshotItemInNotifyIconMenu">托盘显示截图翻译选项</sys:String>
    <sys:String x:Key="General_ShowImageTranslateItemInNotifyIconMenu">托盘显示图片翻译选项</sys:String>
    <sys:String x:Key="General_ShowOcrItemInNotifyIconMenu">托盘显示文本识别选项</sys:String>
    <sys:String x:Key="General_ShowQrCodeItemInNotifyIconMenu">托盘显示二维码选项</sys:String>
    <sys:String x:Key="General_ColorTheme">颜色主题</sys:String>
    <sys:String x:Key="General_ColorThemeDescription">选择要显示的颜色主题。</sys:String>
    <sys:String x:Key="General_ColorThemeButtonVisible">主界面显示颜色主题按钮</sys:String>
    <sys:String x:Key="General_HideInputBox">隐藏输入框</sys:String>
    <sys:String x:Key="General_HideInputBoxDescription">是否要隐藏输入框。</sys:String>
    <sys:String x:Key="General_HideInputBoxButtonVisible">主界面显示隐藏输入框按钮</sys:String>
    <sys:String x:Key="General_HideLanguageControl">隐藏语言选择控件</sys:String>
    <sys:String x:Key="General_HideLanguageControlDescription">隐藏输入框时是否一并隐藏语言选择控件。</sys:String>
    <sys:String x:Key="General_ShowMouseSelectionTranslation">显示鼠标划词直接翻译</sys:String>
    <sys:String x:Key="General_ShowMouseSelectionTranslationDescription">主界面是否显示鼠标划词直接翻译的快捷开关。</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionTranslation">鼠标划词直接翻译</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionTranslationDescription">拖动或双击选中文本后立即复制并触发翻译。</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionIcon">划词后悬浮图标</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionIconDescription">拖动或双击选中文本后显示悬浮图标，点击图标时再翻译；直接翻译同时开启时优先直接翻译。</sys:String>
    <sys:String x:Key="MouseSelectionIconTranslate">点击翻译</sys:String>
    <sys:String x:Key="MouseSelectionTranslationRequiresTopmost">鼠标划词直接翻译启用时窗口必须保持置顶。</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigation">显示历史导航</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigationDescription">主界面是否显示向前/向后历史翻译记录导航图标。</sys:String>
    <sys:String x:Key="General_ShowOcrButton">显示OCR按钮</sys:String>
    <sys:String x:Key="General_ShowOcrButtonDescription">在主界面标题栏显示OCR按钮。</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitor">显示剪贴板监听按钮</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitorDescription">在主界面标题栏显示剪贴板监听切换按钮。</sys:String>
    <sys:String x:Key="General_MainHeaderConfig">主界面标题栏按钮布局</sys:String>
    <sys:String x:Key="General_MainHeaderConfigDescription">上面一行是预览区，下面一行是控件池。把控件从控件池拖到预览区就会显示，拖回控件池就会隐藏；也可以在预览区里拖动调整顺序。</sys:String>
    <sys:String x:Key="General_MainHeaderPreview">预览区（主界面 Header）</sys:String>
    <sys:String x:Key="General_MainHeaderPool">控件池（未显示）</sys:String>
    <sys:String x:Key="General_MainHeaderShowAll">全部显示</sys:String>
    <sys:String x:Key="General_MainHeaderHideAll">全部隐藏</sys:String>
    <sys:String x:Key="General_ShowCloseButton">显示关闭按钮</sys:String>
    <sys:String x:Key="General_ShowCloseButtonDescription">在主界面标题栏设置按钮右侧显示关闭按钮，功能等同于 Esc 键。</sys:String>
    <sys:String x:Key="General_FontSize">字体大小</sys:String>
    <sys:String x:Key="General_FontSizeDescription">调整除「右键菜单」外的所有字体大小</sys:String>
    <sys:String x:Key="General_OutputShowingControl">输出控件显示控制</sys:String>
    <sys:String x:Key="General_ShowPascalCase">显示大驼峰复制按钮</sys:String>
    <sys:String x:Key="General_ShowCamelCase">显示小驼峰复制按钮</sys:String>
    <sys:String x:Key="General_ShowSnakeCase">显示蛇形复制按钮</sys:String>
    <sys:String x:Key="General_ShowInsert">显示插入文本按钮</sys:String>
    <sys:String x:Key="General_ShowBackTranslation">显示回译按钮</sys:String>
    <sys:String x:Key="General_ShowPrompt">提示词</sys:String>
    <sys:String x:Key="General_ShowPromptDescription">主界面是否显示AI翻译服务的提示词切换按钮</sys:String>
    <sys:String x:Key="General_FontFamily">字体</sys:String>
    <sys:String x:Key="General_HistoryCount">历史记录数量</sys:String>
    <sys:String x:Key="General_CopyAfterTranslation">翻译后复制</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationDescription">仅针对「自动执行」的服务生效</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationNotAutomatic">非「自动执行」服务翻译后复制</sys:String>
    <sys:String x:Key="General_CopyAfterOcr">OCR后复制</sys:String>
    <sys:String x:Key="General_CopyAfterOcrDescription">针对所有文本识别场景，识别后自动复制识别结果</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslate">截图翻译后激活输入框</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslateDescription">开启后，截图翻译完成会显示主窗口并聚焦输入框。关闭后，若主窗口已置顶，则只更新结果、不抢焦点；非置顶时仍会恢复显示。</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSource">插件市场CDN源</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSourceDescription">选择插件市场数据的CDN加速服务（GitHub直链无缓存延迟）</sys:String>
    <sys:String x:Key="General_CustomCdnUrl">自定义CDN URL</sys:String>
    <sys:String x:Key="General_CustomCdnUrlDescription">输入自定义CDN地址模板，使用 {author}, {repo}, {branch}, {path} 作为占位符</sys:String>

    <!--  // PluginMarketCdnSourceType //  -->
    <sys:String x:Key="PluginMarketCdnSourceTypeJsDelivr">jsDelivr CDN（推荐）</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeGitHubRaw">GitHub 直链</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeCustom">自定义</sys:String>

    <!--  // PluginDownloadProxyType //  -->
    <sys:String x:Key="PluginDownloadProxyTypeGitHub">GitHub 直连</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyMirror">mirror.ghproxy.com</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyNet">ghproxy.net</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeCustom">自定义</sys:String>

    <!--  // Hotkey Page //  -->
    <sys:String x:Key="GlobalHotkeys">全局热键</sys:String>
    <sys:String x:Key="SoftwareHotkeys">软件热键</sys:String>
    <sys:String x:Key="Hotkey_OpenSTranslate">打开STranslate</sys:String>
    <sys:String x:Key="Hotkey_OpenSTranslateDescription">显示/隐藏STranslate主界面的快捷键。</sys:String>
    <sys:String x:Key="Hotkey_InputTranslate">输入翻译</sys:String>
    <sys:String x:Key="Hotkey_InputTranslateDescription">打开STranslate并清空内容等待输入翻译的快捷键。</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslate">划词翻译</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateDescription">鼠标选中文本触发翻译的快捷键。</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateIsUseCtrlSameC">是否使用 Ctrl+C+C 进行划词翻译？</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateTraditional">传统快捷键</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateByCtrlSameCDescription">鼠标选中文本快速按下 Ctrl+C+C 进行取词翻译。</sys:String>
    <sys:String x:Key="CrosswordTranslateFetchFailed">划词取词失败，已打开输入翻译</sys:String>
    <sys:String x:Key="CrosswordTranslateFetchFailedShowWindow">划词取词失败，已打开主界面显示</sys:String>
    <sys:String x:Key="Hotkey_MouseSelectionTranslation">鼠标划词直接翻译</sys:String>
    <sys:String x:Key="Hotkey_MouseSelectionTranslationDescription">开启或关闭鼠标划词直接翻译。</sys:String>
    <sys:String x:Key="Hotkey_ReplaceTranslate">替换翻译</sys:String>
    <sys:String x:Key="Hotkey_ReplaceTranslateDescription">鼠标选中文本触发翻译并替换原文本的快捷键。</sys:String>
    <sys:String x:Key="Hotkey_ScreenshotTranslate">截图翻译</sys:String>
    <sys:String x:Key="Hotkey_ScreenshotTranslateDescription">截图选择区域后识别文本并翻译的快捷键。</sys:String>
    <sys:String x:Key="Hotkey_ImageTranslate">图片翻译</sys:String>
    <sys:String x:Key="Hotkey_ImageTranslateDescription">截图选择区域后识别在图片上进行翻译的快捷键。</sys:String>
    <sys:String x:Key="Hotkey_SilentOcr">静默OCR</sys:String>
    <sys:String x:Key="Hotkey_SilentOcrDescription">用于截图选取区域，识别文字并将结果设置到剪贴板的快捷键。</sys:String>
    <sys:String x:Key="Hotkey_SilentTts">静默TTS</sys:String>
    <sys:String x:Key="Hotkey_SilentTtsDescription">用于通过鼠标朗读选中的中文文本的快捷键。</sys:String>
    <sys:String x:Key="Hotkey_Ocr">OCR</sys:String>
