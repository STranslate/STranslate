    <sys:String x:Key="General_ShowHistoryNavigation">履歴ナビゲーションを表示</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigationDescription">メイン画面に前/次の翻訳履歴へ移動するアイコンを表示するかどうか。</sys:String>
    <sys:String x:Key="General_ShowOcrButton">OCRボタンを表示</sys:String>
