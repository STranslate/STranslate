    <sys:String x:Key="General_ShowInsert">テキスト挿入ボタンを表示</sys:String>
    <sys:String x:Key="General_ShowBackTranslation">再翻訳ボタンを表示</sys:String>
    <sys:String x:Key="General_ShowPrompt">プロンプト</sys:String>
    <sys:String x:Key="General_ShowPromptDescription">メイン画面にAI翻訳サービスのプロンプト切替ボタンを表示するかどうか。</sys:String>
    <sys:String x:Key="General_FontFamily">フォント</sys:String>
    <sys:String x:Key="General_HistoryCount">履歴記録数</sys:String>
    <sys:String x:Key="General_CopyAfterTranslation">翻訳後にコピー</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationDescription">「自動実行」のサービスのみ有効です。</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationNotAutomatic">「自動実行」以外の翻訳後にコピー</sys:String>
    <sys:String x:Key="General_CopyAfterOcr">OCR後にコピー</sys:String>
    <sys:String x:Key="General_CopyAfterOcrDescription">すべての文字認識シーンにおいて、認識後に結果を自動コピーします。</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslate">スクリーンショット翻訳後に入力欄をアクティブ化</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslateDescription">オン: スクリーンショット翻訳後にメインウィンドウを表示し、入力欄へフォーカスします。オフ: メインウィンドウが最前面のときは結果だけ更新し、フォーカスを奪いません。最前面でない場合は表示を復元します。</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSource">プラグイン市場CDNソース</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSourceDescription">プラグイン市場データのCDN加速サービスを選択（GitHub直リンクはキャッシュ遅延なし）</sys:String>
    <sys:String x:Key="General_CustomCdnUrl">カスタムCDN URL</sys:String>
