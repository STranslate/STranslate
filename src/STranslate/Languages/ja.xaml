    <sys:String x:Key="General_HideInputBoxButtonVisible">メイン画面に入力ボックス非表示ボタンを表示</sys:String>
    <sys:String x:Key="General_HideLanguageControl">言語選択コントロールを隠す</sys:String>
    <sys:String x:Key="General_HideLanguageControlDescription">入力ボックスを隠す際、言語選択コントロールも一緒に隠すかどうか。</sys:String>
    <sys:String x:Key="General_ShowMouseHook">マウスフックを表示</sys:String>
