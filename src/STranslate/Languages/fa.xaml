    <sys:String x:Key="ResetLocation">بازنشانی موقعیت</sys:String>
    <sys:String x:Key="Settings">تنظیمات</sys:String>
    <sys:String x:Key="ImageTranslate">ترجمه تصویر</sys:String>
    <sys:String x:Key="Administrator">مدیر</sys:String>

    <!--  // Navigation //  -->
    <sys:String x:Key="General">عمومی</sys:String>
    <sys:String x:Key="Services">سرویس‌ها</sys:String>
    <sys:String x:Key="ServiceQuickSwitcher">تغییر سریع سرویس</sys:String>
    <sys:String x:Key="NoConfiguredServices">هیچ سرویسی پیکربندی نشده است</sys:String>
    <sys:String x:Key="Translate">ترجمه</sys:String>
    <sys:String x:Key="Ocr">تشخیص متن (OCR)</sys:String>
    <sys:String x:Key="Tts">تبدیل متن به گفتار (TTS)</sys:String>
    <sys:String x:Key="Vocabulary">جعبه واژگان</sys:String>
    <sys:String x:Key="Standalone">پنجره مستقل</sys:String>
    <sys:String x:Key="History">تاریخچه</sys:String>
    <sys:String x:Key="Plugins">افزونه‌ها</sys:String>
    <sys:String x:Key="Hotkeys">کلیدهای میانبر</sys:String>
    <sys:String x:Key="Network">شبکه</sys:String>
    <sys:String x:Key="About">درباره</sys:String>

    <!--  // General Page //  -->
    <sys:String x:Key="TimeoutPlaceholder">زمان انتظار (ثانیه)</sys:String>
    <sys:String x:Key="SearchFunction">جستجوی قابلیت</sys:String>
    <sys:String x:Key="SearchFunctionToolTip">برای جستجوی قابلیت کلیدهای Ctrl+F را فشار دهید</sys:String>
    <sys:String x:Key="NoResultsFound">هیچ نتیجه‌ای یافت نشد</sys:String>
    <sys:String x:Key="Function">قابلیت</sys:String>
    <sys:String x:Key="Appearance">ظاهر</sys:String>
    <sys:String x:Key="AutoTranslateEnabled">فعال‌ کردن ترجمه خودکار</sys:String>
    <sys:String x:Key="AutoTranslateDisabled">غیرفعال‌ کردن ترجمه خودکار</sys:String>
    <sys:String x:Key="General_AutoStartup">شروع به کار خودکار</sys:String>
    <sys:String x:Key="General_AutoStartupDescription">اجرای خودکار نرم‌افزار هنگام روشن شدن رایانه.</sys:String>
    <sys:String x:Key="General_StartMode">حالت شروع</sys:String>
    <sys:String x:Key="General_StartModeDescription">حالت "رد کردن UAC" یک وظیفه زمان‌بندی‌شده برای عدم نمایش پنجره UAC ایجاد می‌کند.</sys:String>
    <sys:String x:Key="General_HideOnStartup">پنهان کردن پنجره هنگام شروع سیستم</sys:String>
    <sys:String x:Key="General_HideOnStartupDescription">پنجره جستجو پس از شروع STranslate در سینی سیستم پنهان می‌شود.</sys:String>
    <sys:String x:Key="General_HideWhenDeactivated">پنهان‌سازی خودکار پنجره با خروج از فوکوس</sys:String>
    <sys:String x:Key="General_WindowPosition">موقعیت پنجره اصلی</sys:String>
    <sys:String x:Key="General_WindowAlign">چیدمان پنجره اصلی روی مانیتور</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatio">حداکثر ارتفاع پنجره اصلی (نسبت به صفحه نمایش)</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatioDescription">تنظیم حداکثر ارتفاع پنجره اصلی بر اساس نسبتی از ناحیه کاری مانیتور (۶۰٪ تا ۱۰۰٪).</sys:String>
    <sys:String x:Key="General_DisableGlobalHotkeys">غیرفعال‌ کردن کلیدهای میانبر سراسری</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreen">نادیده گرفتن میانبرها در حالت تمام‌صفحه</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreenDescription">اولویت کمتری نسبت به "غیرفعال‌سازی کلیدهای میانبر سراسری" دارد و معمولاً برای بازی‌ها استفاده می‌شود.</sys:String>
    <sys:String x:Key="General_LanguageDetector">تشخیص‌دهنده زبان</sys:String>
    <sys:String x:Key="General_LocalDetector">نسبت کاراکترهای انگلیسی به چینی در تشخیص محلی</sys:String>
    <sys:String x:Key="General_LocalDetectorDescription">تنها برای "تشخیص محلی" جهت تعیین نسبت کاراکترهای انگلیسی به کل کاراکترها در متون دو زبانه کاربرد دارد.</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguage">زبان مبدأ پیش‌فرض</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguageDescription">در صورت ناموفق بودن تشخیص خودکار زبان، از این زبان استفاده می‌شود.</sys:String>
    <sys:String x:Key="General_FirstLanguage">زبان اول</sys:String>
    <sys:String x:Key="General_FirstLanguageDescription">هنگامی که زبان مقصد روی خودکار تنظیم شده و زبان مبدأ زبان دیگری باشد، زبان مقصد به زبان اول تغییر می‌کند.</sys:String>
    <sys:String x:Key="General_SecondLanguage">زبان دوم</sys:String>
    <sys:String x:Key="General_SecondLanguageDescription">هنگامی که زبان مقصد روی خودکار تنظیم شده و زبان مبدأ همان زبان اول باشد، زبان مقصد به زبان دوم تغییر می‌کند.</sys:String>
    <sys:String x:Key="General_HttpTimeout">زمان مهلت (Timeout)</sys:String>
    <sys:String x:Key="General_HttpTimeoutDescription">زمان مهلت درخواست شبکه به ثانیه.</sys:String>
    <sys:String x:Key="General_UseClipboardOutput">استفاده از حافظه موقت (Clipboard) برای خروجی متن</sys:String>
    <sys:String x:Key="General_UseClipboardOutputDescription">در صورت فعال بودن، خروجی متن از طریق Ctrl+V حافظه موقت انجام می‌شود؛ در صورت غیرفعال بودن از شبیه‌سازی صفحه کلید استفاده می‌شود (پیش‌فرض).</sys:String>
    <sys:String x:Key="General_TranslateOnPaste">ترجمه بلافاصله پس از چسباندن (Paste)</sys:String>
    <sys:String x:Key="General_TranslateOnPasteDescription">اجرای فوری ترجمه به محض چسباندن متن در کادر ورودی.</sys:String>
    <sys:String x:Key="General_AutoTranslate">ترجمه خودکار</sys:String>
    <sys:String x:Key="General_AutoTranslateDescription">ترجمه متن به طور خودکار پس از زمان انتظار مشخصی هنگام وارد کردن محتوا انجام می‌شود.</sys:String>
    <sys:String x:Key="General_InstantTranslate">ترجمه فوری</sys:String>
    <sys:String x:Key="General_InstantTranslateDescription">اجرای بلافاصله‌ی ترجمه هنگام رخ دادن اقدامات زیر.</sys:String>
    <sys:String x:Key="General_AutoTranslateButtonVisible">نمایش دکمه ترجمه خودکار در رابط اصلی</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChanged">ترجمه خودکار هنگام تغییر پرامپت (Prompt)</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChangedDescription">اجرای مجدد و فوری ترجمه پس از تغییر پرامپت در سرویس‌های ترجمه هوش مصنوعی.</sys:String>
    <sys:String x:Key="General_IncrementalClearInput">پاک‌سازی ورودی در ترجمه افزایشی</sys:String>
    <sys:String x:Key="General_IncrementalClearInputDescription">در صورت فعال بودن (پیش‌فرض)، کادر ورودی هنگام تحریک ترجمه افزایشی پاک می‌شود؛ متون انتخابی در طی نشست همچنان اضافه می‌شوند. در صورت غیرفعال بودن، محتوای قبلی حفظ شده و انتخابی‌های جدید به آن ملحق می‌شوند.</sys:String>
    <sys:String x:Key="General_AutoTranslateDelay">تأخیر ترجمه خودکار</sys:String>
    <sys:String x:Key="General_AutoTranslateDelayDescription">زمان انتظار پس از وارد کردن محتوا، بر حسب میلی‌ثانیه.</sys:String>
    <sys:String x:Key="General_LineBreakHandleType">مدیریت خطوط جدید (Line Breaks)</sys:String>
    <sys:String x:Key="General_LineBreakHandleTypeDescription" xml:space="preserve">شامل مدیریت خط جدید برای انتخاب متن، ترجمه اسکرین‌شات، حافظه موقت و OCR خاموش است.
«حذف خطوط جدید اضافی» عمدتاً برای استخراج متن PDF جهت حذف شکستگی‌های اضافی جملات است، اما ممکن است بر استخراج‌های غیر PDF تأثیر بگذارد.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleType">مدیریت جداکننده‌های متن</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleTypeDescription">تبدیل خط‌تیره یا خط‌زیر در شناسه کلمات انگلیسی/عددی به فاصله. به طور پیش‌فرض غیرفعال است.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopes">محدوده اعمال مدیریت جداکننده‌ها</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopesDescription">انتخاب ورودی‌های دریافت متن که پردازش جداکننده روی آن‌ها اعمال شود. عدم انتخاب باعث حفظ متن اصلی می‌شود.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeout">زمان مهلت دریافت متن انتخابی</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutDescription">زمان مهلت برای استعلام متن جدید از حافظه موقت پس از کپی شبیه‌سازی‌شده، بر حسب میلی‌ثانیه. به محض به‌روزرسانی متن بازمی‌گردد؛ برای برنامه‌های PDF کند این مقدار را افزایش دهید.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutPlaceholder">500</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTarget">جایگزین عدم موفقیت در دریافت متن انتخابی</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTargetDescription">در صورت شکست در دریافت متن انتخاب‌شده، انتخاب کنید که به ترجمه ورودی سوئیچ شود یا فقط پنجره اصلی نمایش داده شود.</sys:String>
    <sys:String x:Key="General_ImageQuality">کیفیت تصویر</sys:String>
    <sys:String x:Key="General_ImageQualityDescription">تنظیم کیفیت هنگام پردازش تصاویر. سرویس‌های آنلاین OCR ممکن است اندازه تصویر را محدود کنند.</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunction">عملکرد دوبار کلیک روی آیکون سینی</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunctionDescription">انتخاب هر عملی به جز "بدون عمل"، عملکرد تک‌کلیک سینی برای نمایش/پنهان پنجره اصلی را غیرفعال می‌کند.</sys:String>
    <sys:String x:Key="General_Language">زبان</sys:String>
    <sys:String x:Key="General_ScreenshotTranslate">ترجمه اسکرین‌شات</sys:String>
    <sys:String x:Key="General_ImageTranslate">ترجمه تصویر</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslate">نمایش ترجمه اسکرین‌شات</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslateDescription">نمایش دکمه "ترجمه اسکرین‌شات" در رابط اصلی. گرفتن اسکرین‌شات، تشخیص متن، قرار دادن آن در کادر ورودی و سپس انجام ترجمه</sys:String>
    <sys:String x:Key="General_ShowImageTranslate">نمایش ترجمه تصویر</sys:String>
    <sys:String x:Key="General_ShowImageTranslateDescription">نمایش دکمه "ترجمه تصویر" در رابط اصلی. گرفتن اسکرین‌شات و ترجمه مستقیم روی خود تصویر</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLines">خطوط راهنمای اسکرین‌شات</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLinesDescription">نمایش یا عدم نمایش خطوط راهنما در زمان اسکرین‌شات برای انتخاب دقیق‌تر ناحیه.</sys:String>
    <sys:String x:Key="General_HideNotifyIcon">پنهان کردن آیکون سینی</sys:String>
    <sys:String x:Key="General_ShowScreenshotItemInNotifyIconMenu">نمایش گزینه‌ی ترجمه اسکرین‌شات در منوی سینی</sys:String>
    <sys:String x:Key="General_ShowImageTranslateItemInNotifyIconMenu">نمایش گزینه‌ی ترجمه تصویر در منوی سینی</sys:String>
    <sys:String x:Key="General_ShowOcrItemInNotifyIconMenu">نمایش گزینه‌ی تشخیص متن در منوی سینی</sys:String>
    <sys:String x:Key="General_ShowQrCodeItemInNotifyIconMenu">نمایش گزینه‌ی کُد QR در منوی سینی</sys:String>
    <sys:String x:Key="General_ColorTheme">تم رنگی</sys:String>
    <sys:String x:Key="General_ColorThemeDescription">تم رنگی مورد نظر برای نمایش را انتخاب کنید.</sys:String>
    <sys:String x:Key="General_ColorThemeButtonVisible">نمایش دکمه تم رنگی در رابط اصلی</sys:String>
    <sys:String x:Key="General_HideInputBox">پنهان کردن کادر ورودی</sys:String>
    <sys:String x:Key="General_HideInputBoxDescription">آیا کادر ورودی پنهان شود یا خیر.</sys:String>
    <sys:String x:Key="General_HideInputBoxButtonVisible">نمایش دکمه پنهان کردن کادر ورودی در رابط اصلی</sys:String>
    <sys:String x:Key="General_HideLanguageControl">پنهان کردن کنترل انتخاب زبان</sys:String>
    <sys:String x:Key="General_HideLanguageControlDescription">هنگام پنهان بودن کادر ورودی، آیا کنترل انتخاب زبان نیز پنهان شود یا خیر.</sys:String>
    <sys:String x:Key="General_ShowMouseSelectionTranslation">نمایش ترجمه مستقیم با انتخاب موش‌واره (Mouse)</sys:String>
    <sys:String x:Key="General_ShowMouseSelectionTranslationDescription">نمایش کلید تغییر حالت ترجمه مستقیم انتخابی در پنجره اصلی.</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionTranslation">ترجمه مستقیم با انتخاب متن</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionTranslationDescription">متن را پس از انتخاب با کشیدن موش‌واره یا دوبار کلیک، بلافاصله کپی و ترجمه می‌کند.</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionIcon">آیکون شناور پس از انتخاب متن</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionIconDescription">پس از انتخاب متن با کشیدن موش‌واره یا دوبار کلیک، یک آیکون شناور نمایش می‌دهد و با کلیک روی آن ترجمه می‌کند. در صورت فعال بودن هر دو، ترجمه مستقیم اولویت دارد.</sys:String>
    <sys:String x:Key="MouseSelectionIconTranslate">ترجمه</sys:String>
    <sys:String x:Key="MouseSelectionTranslationRequiresTopmost">هنگام فعال بودن ترجمه با انتخاب موش‌واره، پنجره باید همیشه در رو (Topmost) بماند.</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigation">نمایش پیمایش تاریخچه</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigationDescription">نمایش یا عدم نمایش آیکون‌های پیمایش قبلی/بعدی تاریخچه در رابط اصلی.</sys:String>
    <sys:String x:Key="General_ShowOcrButton">نمایش دکمه OCR</sys:String>
    <sys:String x:Key="General_ShowOcrButtonDescription">نمایش دکمه OCR در نوار عنوان رابط اصلی.</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitor">نمایش دکمه پایش حافظه موقت</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitorDescription">نمایش دکمه تغییر حالت پایش حافظه موقت در نوار عنوان رابط اصلی.</sys:String>
    <sys:String x:Key="General_MainHeaderConfig">چیدمان دکمه‌های نوار عنوان اصلی</sys:String>
    <sys:String x:Key="General_MainHeaderConfigDescription">سطر بالا پیش‌نمایش و سطر پایین مخزن دکمه‌ها است. دکمه‌ای را از مخزن به پیش‌نمایش بکشید تا ظاهر شود، برای پنهان کردن به مخزن بازگردانید، و در پیش‌نمایش جابه‌جا کنید تا ترتیب تغییر کند.</sys:String>
    <sys:String x:Key="General_MainHeaderPreview">پیش‌نمایش (نوار عنوان اصلی)</sys:String>
    <sys:String x:Key="General_MainHeaderPool">مخزن دکمه‌ها (پنهان)</sys:String>
    <sys:String x:Key="General_MainHeaderShowAll">نمایش همه</sys:String>
    <sys:String x:Key="General_MainHeaderHideAll">پنهان‌سازی همه</sys:String>
    <sys:String x:Key="General_ShowCloseButton">نمایش دکمه بستن</sys:String>
    <sys:String x:Key="General_ShowCloseButtonDescription">نمایش دکمه بستن در سمت راست دکمه تنظیمات در نوار عنوان. رفتاری مشابه کلید Esc دارد.</sys:String>
    <sys:String x:Key="General_FontSize">اندازه فونت</sys:String>
    <sys:String x:Key="General_FontSizeDescription">تنظیم اندازه فونت برای همه عناصر به جز منوی راست‌کلیک</sys:String>
    <sys:String x:Key="General_OutputShowingControl">کنترل نمایش خروجی</sys:String>
    <sys:String x:Key="General_ShowPascalCase">نمایش دکمه کپی به صورت PascalCase</sys:String>
    <sys:String x:Key="General_ShowCamelCase">نمایش دکمه کپی به صورت camelCase</sys:String>
    <sys:String x:Key="General_ShowSnakeCase">نمایش دکمه کپی به صورت snake_case</sys:String>
    <sys:String x:Key="General_ShowInsert">نمایش دکمه درج متن</sys:String>
    <sys:String x:Key="General_ShowBackTranslation">نمایش دکمه ترجمه بازگشتی (Back Translation)</sys:String>
    <sys:String x:Key="General_ShowPrompt">نمایش پرامپت</sys:String>
    <sys:String x:Key="General_ShowPromptDescription">نمایش یا عدم نمایش دکمه تغییر پرامپت سرویس‌های ترجمه هوش مصنوعی در رابط اصلی</sys:String>
    <sys:String x:Key="General_FontFamily">فونت</sys:String>
    <sys:String x:Key="General_HistoryCount">تعداد سوابق تاریخچه</sys:String>
    <sys:String x:Key="General_CopyAfterTranslation">کپی پس از ترجمه</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationDescription">تنها برای سرویس‌های دارای حالت "خودکار" اعمال می‌شود</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationNotAutomatic">کپی پس از ترجمه برای سرویس‌های غیر "خودکار"</sys:String>
    <sys:String x:Key="General_CopyAfterOcr">کپی پس از OCR</sys:String>
    <sys:String x:Key="General_CopyAfterOcrDescription">برای تمامی حالات تشخیص متن، نتیجه به طور خودکار پس از OCR کپی می‌شود.</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslate">فوکوس روی کادر ورودی پس از ترجمه اسکرین‌شات</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslateDescription">فعال: نمایش پنجره اصلی و فوکوس روی کادر ورودی پس از ترجمه اسکرین‌شات. غیرفعال: اگر پنجره در رو باشد، نتایج بدون گرفتن فوکوس به روز می‌شوند؛ پنجره‌های غیر در رو همچنان بازمی‌شوند.</sys:String>
