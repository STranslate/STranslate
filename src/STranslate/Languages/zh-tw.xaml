    <sys:String x:Key="Administrator">管理員</sys:String>

    <!--  // Navigation //  -->
    <sys:String x:Key="General">常規</sys:String>
    <sys:String x:Key="Services">服務</sys:String>
    <sys:String x:Key="ServiceQuickSwitcher">服務快速開關</sys:String>
    <sys:String x:Key="NoConfiguredServices">尚未設定任何服務</sys:String>
    <sys:String x:Key="Translate">文本翻譯</sys:String>
    <sys:String x:Key="Ocr">文本識別</sys:String>
    <sys:String x:Key="Tts">語音合成</sys:String>
    <sys:String x:Key="Vocabulary">生詞本</sys:String>
    <sys:String x:Key="Standalone">獨立視窗</sys:String>
    <sys:String x:Key="History">歷史</sys:String>
    <sys:String x:Key="Plugins">外掛</sys:String>
    <sys:String x:Key="Hotkeys">熱鍵</sys:String>
    <sys:String x:Key="Network">網絡</sys:String>
    <sys:String x:Key="About">關於</sys:String>

    <!--  // General Page //  -->
    <sys:String x:Key="TimeoutPlaceholder">逾時時間（秒）</sys:String>
    <sys:String x:Key="SearchFunction">搜尋功能</sys:String>
    <sys:String x:Key="SearchFunctionToolTip">按 Ctrl+F 搜尋功能</sys:String>
    <sys:String x:Key="Function">功能</sys:String>
    <sys:String x:Key="Appearance">外觀</sys:String>
    <sys:String x:Key="AutoTranslateEnabled">啟用自動翻譯</sys:String>
    <sys:String x:Key="AutoTranslateDisabled">停用自動翻譯</sys:String>
    <sys:String x:Key="General_AutoStartup">開機自動啟動</sys:String>
    <sys:String x:Key="General_AutoStartupDescription">電腦啟動時軟體自動啟動。</sys:String>
    <sys:String x:Key="General_StartMode">啟動模式</sys:String>
    <sys:String x:Key="General_StartModeDescription">「跳過UAC管理員啟動」將建立一個計劃任務來跳過UAC彈出視窗。</sys:String>
    <sys:String x:Key="General_HideOnStartup">系統啟動時不顯示主視窗</sys:String>
    <sys:String x:Key="General_HideOnStartupDescription">STranslate 啟動後搜尋視窗隱藏在托盤中。</sys:String>
    <sys:String x:Key="General_HideWhenDeactivated">失去焦點時自動隱藏主視窗</sys:String>
    <sys:String x:Key="General_WindowPosition">主視窗位置</sys:String>
    <sys:String x:Key="General_WindowAlign">主視窗在顯示器上的位置</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatio">主視窗最大高度（螢幕比例）</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatioDescription">控制主視窗最大高度占目前顯示器工作區的比例（60%~100%）。</sys:String>
    <sys:String x:Key="General_DisableGlobalHotkeys">停用全域快捷鍵</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreen">全螢幕模式下忽略快捷鍵</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreenDescription">優先順序低於「停用全域快捷鍵」，一般用於遊戲場景。</sys:String>
    <sys:String x:Key="General_LanguageDetector">語言檢測器</sys:String>
    <sys:String x:Key="General_LocalDetector">本地識別中英字元比例</sys:String>
    <sys:String x:Key="General_LocalDetectorDescription">僅針對「本地識別」中英文情況下英文字元佔總字元數的比例。</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguage">預設來源語言</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguageDescription">當自動檢測失敗時使用此語言。</sys:String>
    <sys:String x:Key="General_FirstLanguage">第一語言</sys:String>
    <sys:String x:Key="General_FirstLanguageDescription">當任一翻譯場景的目標語言設為自動，且來源語言為其他語言（包含第二語言）時，目標語言使用第一語言。</sys:String>
    <sys:String x:Key="General_SecondLanguage">第二語言</sys:String>
    <sys:String x:Key="General_SecondLanguageDescription">當任一翻譯場景的目標語言設為自動，且來源語言為第一語言時，目標語言使用第二語言。</sys:String>
    <sys:String x:Key="General_HttpTimeout">逾時時間</sys:String>
    <sys:String x:Key="General_HttpTimeoutDescription">網路請求的逾時時間，單位：秒。</sys:String>
    <sys:String x:Key="General_UseClipboardOutput">文字輸出使用剪貼簿</sys:String>
    <sys:String x:Key="General_UseClipboardOutputDescription">啟用後將透過剪貼簿 Ctrl+V 輸出文字；關閉時使用鍵盤模擬輸入（預設）。</sys:String>
    <sys:String x:Key="General_TranslateOnPaste">貼上立即翻譯</sys:String>
    <sys:String x:Key="General_TranslateOnPasteDescription">輸入框內貼上文字立即執行翻譯。</sys:String>
    <sys:String x:Key="General_AutoTranslate">自動翻譯</sys:String>
    <sys:String x:Key="General_AutoTranslateDescription">輸入內容等待一定時間後自動執行翻譯。</sys:String>
    <sys:String x:Key="General_InstantTranslate">立即翻譯</sys:String>
    <sys:String x:Key="General_InstantTranslateDescription">以下操作觸發後將立即執行翻譯。</sys:String>
    <sys:String x:Key="General_AutoTranslateButtonVisible">在主界面上顯示自動翻譯按鈕</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChanged">切換提示詞後自動翻譯</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChangedDescription">切換 AI 翻譯服務的提示詞後，立即重新執行翻譯。</sys:String>
    <sys:String x:Key="General_IncrementalClearInput">增量翻譯時清空輸入</sys:String>
    <sys:String x:Key="General_IncrementalClearInputDescription">啟用後（預設）觸發增量翻譯時清空輸入框，本次工作階段內選取文字仍累加附加；停用後保留舊邏輯，不清空原有內容，直接附加。</sys:String>
    <sys:String x:Key="General_AutoTranslateDelay">自動翻譯延時</sys:String>
    <sys:String x:Key="General_AutoTranslateDelayDescription">輸入內容等待時間，單位：毫秒。</sys:String>
    <sys:String x:Key="General_LineBreakHandleType">取詞換行處理</sys:String>
    <sys:String x:Key="General_LineBreakHandleTypeDescription" xml:space="preserve">包括劃詞、截圖翻譯、剪貼簿、靜默 OCR 取詞場景的換行處理。&#10;「移除多餘換行」主要針對 PDF 取詞場景，移除多餘的換行與斷句，但對非 PDF 取詞可能會有影響。</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleType">取詞分隔符處理</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleTypeDescription">將英文/數字識別符中的底線或中劃線轉換為空格，預設不處理。</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopes">分隔符處理生效範圍</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopesDescription">選擇哪些取詞入口套用分隔符處理。未選擇時保留原文字。</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeout">取詞逾時時間</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutDescription">模擬複製後輪詢剪貼簿新文字的逾時時間，單位：毫秒。寫入成功會立即返回；部分 PDF 軟體寫入較慢時可適當調高。</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutPlaceholder">500</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTarget">劃詞取詞失敗回退目標</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTargetDescription">劃詞取詞失敗後，選擇回退到輸入翻譯或僅顯示主介面。</sys:String>
    <sys:String x:Key="General_ImageQuality">圖片品質</sys:String>
    <sys:String x:Key="General_ImageQualityDescription">處理圖片時調整品質，線上OCR服務可能會限制圖片大小。</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunction">雙擊托盤功能</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunctionDescription">選擇除「無操作」的其他操作會停用托盤單擊切換主視窗顯示功能。</sys:String>
    <sys:String x:Key="General_Language">語言</sys:String>
    <sys:String x:Key="General_ScreenshotTranslate">擷圖翻譯</sys:String>
    <sys:String x:Key="General_ImageTranslate">圖片翻譯</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslate">顯示擷圖翻譯</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslateDescription">在主介面上顯示「擷圖翻譯」按鈕，擷圖並辨識結果填充到輸入框後執行翻譯</sys:String>
    <sys:String x:Key="General_ShowImageTranslate">顯示圖片翻譯</sys:String>
    <sys:String x:Key="General_ShowImageTranslateDescription">在主介面上顯示「圖片翻譯」按鈕，擷圖後在圖片上進行翻譯</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLines">截圖輔助線</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLinesDescription">截圖時是否顯示輔助線，幫助更精確地選擇區域。</sys:String>
    <sys:String x:Key="General_HideNotifyIcon">隱藏托盤圖示</sys:String>
    <sys:String x:Key="General_ShowScreenshotItemInNotifyIconMenu">托盤顯示截圖翻譯選項</sys:String>
    <sys:String x:Key="General_ShowImageTranslateItemInNotifyIconMenu">托盤顯示圖片翻譯選項</sys:String>
    <sys:String x:Key="General_ShowOcrItemInNotifyIconMenu">托盤顯示文字識別選項</sys:String>
    <sys:String x:Key="General_ShowQrCodeItemInNotifyIconMenu">托盤顯示二維碼選項</sys:String>
    <sys:String x:Key="General_ColorTheme">顏色主題</sys:String>
    <sys:String x:Key="General_ColorThemeDescription">選擇要顯示的顏色主題。</sys:String>
    <sys:String x:Key="General_ColorThemeButtonVisible">主界面顯示顏色主題按鈕</sys:String>
    <sys:String x:Key="General_HideInputBox">隱藏輸入框</sys:String>
    <sys:String x:Key="General_HideInputBoxDescription">是否要隱藏輸入框。</sys:String>
    <sys:String x:Key="General_HideInputBoxButtonVisible">主界面顯示隱藏輸入框按鈕</sys:String>
    <sys:String x:Key="General_HideLanguageControl">隱藏語言選擇控制項</sys:String>
    <sys:String x:Key="General_HideLanguageControlDescription">隱藏輸入框時是否一併隱藏語言選擇控制項。</sys:String>
    <sys:String x:Key="General_ShowMouseHook">顯示滑鼠鉤子</sys:String>
    <sys:String x:Key="General_ShowMouseHookDescription">主介面是否顯示快捷啟用/禁用監聽滑鼠劃詞圖示。</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigation">顯示歷史導航</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigationDescription">主介面是否顯示向前/向後歷史翻譯記錄導航圖示。</sys:String>
    <sys:String x:Key="General_ShowOcrButton">顯示OCR按鈕</sys:String>
    <sys:String x:Key="General_ShowOcrButtonDescription">在主介面標題欄顯示OCR按鈕。</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitor">顯示剪貼簿監聽按鈕</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitorDescription">在主介面標題欄顯示剪貼簿監聽切換按鈕。</sys:String>
    <sys:String x:Key="General_MainHeaderConfig">主介面標題列按鈕佈局</sys:String>
    <sys:String x:Key="General_MainHeaderConfigDescription">上面一行是預覽區，下面一行是控件池。把控件從控件池拖到預覽區就會顯示，拖回控件池就會隱藏；也可以在預覽區內拖動調整順序。</sys:String>
    <sys:String x:Key="General_MainHeaderPreview">預覽區（主介面 Header）</sys:String>
    <sys:String x:Key="General_MainHeaderPool">控件池（未顯示）</sys:String>
    <sys:String x:Key="General_MainHeaderShowAll">全部顯示</sys:String>
    <sys:String x:Key="General_MainHeaderHideAll">全部隱藏</sys:String>
    <sys:String x:Key="General_ShowCloseButton">顯示關閉按鈕</sys:String>
    <sys:String x:Key="General_ShowCloseButtonDescription">在主介面標題欄設定按鈕右側顯示關閉按鈕，功能等同於 Esc 鍵。</sys:String>
    <sys:String x:Key="General_FontSize">字體大小</sys:String>
    <sys:String x:Key="General_FontSizeDescription">調整除「右鍵選單」外的所有字型大小</sys:String>
    <sys:String x:Key="General_OutputShowingControl">輸出控件顯示控制</sys:String>
    <sys:String x:Key="General_ShowPascalCase">顯示大駝峰複製按鈕</sys:String>
    <sys:String x:Key="General_ShowCamelCase">顯示小駝峰複製按鈕</sys:String>
    <sys:String x:Key="General_ShowSnakeCase">顯示蛇形複製按鈕</sys:String>
    <sys:String x:Key="General_ShowInsert">顯示插入文字按鈕</sys:String>
    <sys:String x:Key="General_ShowBackTranslation">顯示回譯按鈕</sys:String>
    <sys:String x:Key="General_ShowPrompt">提示詞</sys:String>
    <sys:String x:Key="General_ShowPromptDescription">主介面是否顯示 AI 翻譯服務的提示詞切換按鈕</sys:String>
    <sys:String x:Key="General_FontFamily">字體</sys:String>
    <sys:String x:Key="General_HistoryCount">歷史記錄數量</sys:String>
    <sys:String x:Key="General_CopyAfterTranslation">翻譯後複製</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationDescription">僅針對「自動執行」的服務生效</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationNotAutomatic">非「自動執行」服務翻譯後複製</sys:String>
    <sys:String x:Key="General_CopyAfterOcr">OCR後複製</sys:String>
    <sys:String x:Key="General_CopyAfterOcrDescription">針對所有文字識別場景，識別後自動複製識別結果。</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslate">截圖翻譯後啟用輸入框</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslateDescription">開啟後，截圖翻譯完成會顯示主視窗並聚焦輸入框。關閉後，若主視窗已置頂，則只更新結果、不搶焦點；非置頂時仍會恢復顯示。</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSource">外掛市場CDN來源</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSourceDescription">選擇外掛市場資料的CDN加速服務（GitHub直鏈無快取延遲）</sys:String>
    <sys:String x:Key="General_CustomCdnUrl">自訂CDN網址</sys:String>
    <sys:String x:Key="General_CustomCdnUrlDescription">輸入自訂CDN位址模板，使用 {author}, {repo}, {branch}, {path} 作為佔位符</sys:String>

    <!--  // PluginMarketCdnSourceType //  -->
    <sys:String x:Key="PluginMarketCdnSourceTypeJsDelivr">jsDelivr CDN（推薦）</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeGitHubRaw">GitHub 直鏈</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeCustom">自訂</sys:String>

    <!--  // PluginDownloadProxyType //  -->
    <sys:String x:Key="PluginDownloadProxyTypeGitHub">GitHub 直連</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyMirror">mirror.ghproxy.com</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyNet">ghproxy.net</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeCustom">自訂</sys:String>

    <!--  // Hotkey Page //  -->
    <sys:String x:Key="GlobalHotkeys">全域快速鍵</sys:String>
    <sys:String x:Key="SoftwareHotkeys">軟體快速鍵</sys:String>
    <sys:String x:Key="Hotkey_OpenSTranslate">開啟STranslate</sys:String>
    <sys:String x:Key="Hotkey_OpenSTranslateDescription">顯示/隱藏STranslate主界面的快速鍵。</sys:String>
    <sys:String x:Key="Hotkey_InputTranslate">輸入翻譯</sys:String>
    <sys:String x:Key="Hotkey_InputTranslateDescription">開啟STranslate並清空內容等待輸入翻譯的快速鍵。</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslate">劃詞翻譯</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateDescription">滑鼠選中文字觸發翻譯的快速鍵。</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateIsUseCtrlSameC">是否使用 Ctrl+C+C 進行劃詞翻譯？</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateTraditional">傳統快速鍵</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateByCtrlSameCDescription">滑鼠選中文字快速按下 Ctrl+C+C 進行取詞翻譯。</sys:String>
    <sys:String x:Key="CrosswordTranslateFetchFailed">劃詞取詞失敗，已開啟輸入翻譯</sys:String>
    <sys:String x:Key="CrosswordTranslateFetchFailedShowWindow">劃詞取詞失敗，已開啟主介面顯示</sys:String>
    <sys:String x:Key="Hotkey_MouseHookTranslate">監聽滑鼠劃詞</sys:String>
    <sys:String x:Key="Hotkey_MouseHookTranslateDescription">開啟/關閉監聽滑鼠劃詞選中文字觸發翻譯的快速鍵。</sys:String>
    <sys:String x:Key="Hotkey_CursorOcrTranslate">游標取詞翻譯</sys:String>
    <sys:String x:Key="Hotkey_CursorOcrTranslateDescription">自動辨識游標下方的文字並呼叫文字翻譯服務，無需手動截圖。</sys:String>
    <sys:String x:Key="CursorOcrTranslateFailed">沒有辨識到游標下方的文字</sys:String>
    <sys:String x:Key="CursorOcrAutoPlayAudio">游標取詞後自動發音</sys:String>
    <sys:String x:Key="CursorOcrAutoPlayAudioDescription">僅在游標取詞成功後，使用目前啟用的語音合成服務播放單字發音。</sys:String>
    <sys:String x:Key="Hotkey_ReplaceTranslate">替換翻譯</sys:String>
    <sys:String x:Key="Hotkey_ReplaceTranslateDescription">滑鼠選中文本後觸發翻譯並替換原文本的快捷鍵。</sys:String>
    <sys:String x:Key="Hotkey_ScreenshotTranslate">截圖翻譯</sys:String>
    <sys:String x:Key="Hotkey_ScreenshotTranslateDescription">截圖選取區域後辨識文字並進行翻譯的快捷鍵。</sys:String>
    <sys:String x:Key="Hotkey_ImageTranslate">圖片翻譯</sys:String>
    <sys:String x:Key="Hotkey_ImageTranslateDescription">擷圖選擇區域後辨識在圖片上進行翻譯的快速鍵。</sys:String>
    <sys:String x:Key="Hotkey_SilentOcr">靜默OCR</sys:String>
    <sys:String x:Key="Hotkey_SilentOcrDescription">用於截圖選取區域，辨識文字並將結果設定到剪貼簿的快捷鍵。</sys:String>
    <sys:String x:Key="Hotkey_SilentTts">靜默TTS</sys:String>
    <sys:String x:Key="Hotkey_SilentTtsDescription">用於透過滑鼠朗讀選取的中文文字的快捷鍵。</sys:String>
    <sys:String x:Key="Hotkey_Ocr">OCR</sys:String>
    <sys:String x:Key="Hotkey_OcrDescription">用於呼叫 OCR 視窗進行文字辨識的快捷鍵。</sys:String>
    <sys:String x:Key="Hotkey_ClipboardMonitor">剪貼簿監聽翻譯</sys:String>
    <sys:String x:Key="Hotkey_ClipboardMonitorDescription">開啟/關閉剪貼簿監聽，監聽開啟時剪貼簿變化會自動翻譯。</sys:String>
    <sys:String x:Key="ClipboardMonitorStarted">剪貼簿監聽已開啟</sys:String>
    <sys:String x:Key="ClipboardMonitorStopped">剪貼簿監聽已關閉</sys:String>
