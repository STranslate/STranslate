    <!--  // General Page //  -->
    <sys:String x:Key="TimeoutPlaceholder">Таймаут (секунды)</sys:String>
    <sys:String x:Key="SearchFunction">Поиск функций</sys:String>
    <sys:String x:Key="SearchFunctionToolTip">Ctrl+F — поиск функций</sys:String>
    <sys:String x:Key="NoResultsFound">Ничего не найдено</sys:String>
    <sys:String x:Key="Function">Функции</sys:String>
    <sys:String x:Key="Appearance">Внешний вид</sys:String>
    <sys:String x:Key="AutoTranslateEnabled">Включить автоперевод</sys:String>
    <sys:String x:Key="AutoTranslateDisabled">Отключить автоперевод</sys:String>
    <sys:String x:Key="General_AutoStartup">Автозапуск</sys:String>
    <sys:String x:Key="General_AutoStartupDescription">Запускать программу автоматически при включении компьютера.</sys:String>
    <sys:String x:Key="General_StartMode">Режим запуска</sys:String>
    <sys:String x:Key="General_StartModeDescription">Режим «Без запроса UAC» создаёт задание в планировщике, чтобы окно UAC не появлялось.</sys:String>
    <sys:String x:Key="General_HideOnStartup">Скрывать окно при запуске системы</sys:String>
    <sys:String x:Key="General_HideOnStartupDescription">После запуска STranslate главное окно скрывается в трее.</sys:String>
    <sys:String x:Key="General_HideWhenDeactivated">Автоматически скрывать окно при потере фокуса</sys:String>
    <sys:String x:Key="General_WindowPosition">Где открывать главное окно</sys:String>
    <sys:String x:Key="General_WindowAlign">Положение главного окна на экране</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatio">Максимальная высота главного окна (доля экрана)</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatioDescription">Задаёт максимальную высоту главного окна в долях рабочей области текущего экрана (60%–100%).</sys:String>
    <sys:String x:Key="General_DisableGlobalHotkeys">Отключить глобальные горячие клавиши</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreen">Игнорировать горячие клавиши в полноэкранном режиме</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreenDescription">Приоритет ниже, чем у настройки «Отключить глобальные горячие клавиши»; обычно нужно в играх.</sys:String>
    <sys:String x:Key="General_LanguageDetector">Определение языка</sys:String>
    <sys:String x:Key="General_LocalDetector">Доля английских символов для локального определения</sys:String>
    <sys:String x:Key="General_LocalDetectorDescription">Применяется только к режиму «Локальное определение»: доля английских символов от общего числа символов в китайско-английском тексте.</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguage">Исходный язык по умолчанию</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguageDescription">Использовать этот язык, если определить язык автоматически не удалось.</sys:String>
    <sys:String x:Key="General_FirstLanguage">Первый язык</sys:String>
    <sys:String x:Key="General_FirstLanguageDescription">Если в любом сценарии перевода языком перевода выбран «Авто», а исходный язык другой (в том числе второй язык), переводить на первый язык.</sys:String>
    <sys:String x:Key="General_SecondLanguage">Второй язык</sys:String>
    <sys:String x:Key="General_SecondLanguageDescription">Если в любом сценарии перевода языком перевода выбран «Авто», а исходный язык — первый, переводить на второй язык.</sys:String>
    <sys:String x:Key="General_HttpTimeout">Таймаут</sys:String>
    <sys:String x:Key="General_HttpTimeoutDescription">Таймаут сетевого запроса в секундах.</sys:String>
    <sys:String x:Key="General_UseClipboardOutput">Выводить текст через буфер обмена</sys:String>
    <sys:String x:Key="General_UseClipboardOutputDescription">Если включено, текст вставляется из буфера обмена через Ctrl+V; если выключено — эмулируется ввод с клавиатуры (по умолчанию).</sys:String>
    <sys:String x:Key="General_TranslateOnPaste">Переводить при вставке</sys:String>
    <sys:String x:Key="General_TranslateOnPasteDescription">Сразу переводить текст, вставленный в поле ввода.</sys:String>
    <sys:String x:Key="General_AutoTranslate">Автоперевод</sys:String>
    <sys:String x:Key="General_AutoTranslateDescription">Автоматически запускать перевод через заданное время после ввода текста.</sys:String>
    <sys:String x:Key="General_InstantTranslate">Мгновенный перевод</sys:String>
    <sys:String x:Key="General_InstantTranslateDescription">Сразу запускать перевод при следующих действиях.</sys:String>
    <sys:String x:Key="General_AutoTranslateButtonVisible">Показывать кнопку автоперевода в главном окне</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChanged">Автоперевод при смене промпта</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChangedDescription">Сразу повторять перевод после переключения промпта у ИИ-сервисов перевода.</sys:String>
    <sys:String x:Key="General_IncrementalClearInput">Очищать поле ввода при накопительном переводе</sys:String>
    <sys:String x:Key="General_IncrementalClearInputDescription">Если включено (по умолчанию), при запуске накопительного перевода поле ввода очищается, но выделенные за сеанс фрагменты всё равно дописываются. Если выключено, прежнее содержимое сохраняется, а новые выделения дописываются к нему.</sys:String>
    <sys:String x:Key="General_AutoTranslateDelay">Задержка автоперевода</sys:String>
    <sys:String x:Key="General_AutoTranslateDelayDescription">Пауза после ввода текста, в миллисекундах.</sys:String>
    <sys:String x:Key="General_LineBreakHandleType">Обработка переносов строк</sys:String>
    <sys:String x:Key="General_LineBreakHandleTypeDescription" xml:space="preserve">Действует при переводе выделенного текста, переводе скриншота, работе с буфером обмена и фоновом распознавании.&#10;Режим «Удалять лишние переносы строк» рассчитан прежде всего на текст из PDF: он убирает лишние переносы и разрывы предложений, но может повлиять и на текст из других источников.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleType">Обработка разделителей в тексте</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleTypeDescription">Заменяет подчёркивания или дефисы внутри латинских и цифровых идентификаторов на пробелы. По умолчанию выключено.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopes">Область обработки разделителей</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopesDescription">Выберите, при каких способах получения текста применять обработку разделителей. Если ничего не выбрано, текст остаётся без изменений.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeout">Таймаут получения текста</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutDescription">Сколько ждать появления нового текста в буфере обмена после эмуляции копирования, в миллисекундах. Как только текст обновится, ожидание прекращается; для медленных PDF-программ значение стоит увеличить.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutPlaceholder">500</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTarget">Если не удалось получить выделенный текст</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTargetDescription">Выберите, что делать, если получить выделенный текст не удалось: перейти к переводу из поля ввода или только показать главное окно.</sys:String>
    <sys:String x:Key="General_ImageQuality">Качество изображения</sys:String>
    <sys:String x:Key="General_ImageQualityDescription">Качество обработки изображений. Онлайн-сервисы распознавания текста могут ограничивать размер изображения.</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunction">Двойной щелчок по значку в трее</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunctionDescription">Любое действие, кроме «Нет», отключает показ и скрытие главного окна одиночным щелчком по значку в трее.</sys:String>
    <sys:String x:Key="General_Language">Язык интерфейса</sys:String>
    <sys:String x:Key="General_ScreenshotTranslate">Перевод скриншота</sys:String>
    <sys:String x:Key="General_ImageTranslate">Перевод изображения</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslate">Показывать кнопку перевода скриншота</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslateDescription">Показывать в главном окне кнопку «Перевод скриншота». Программа делает снимок экрана, распознаёт текст, вставляет его в поле ввода и переводит</sys:String>
    <sys:String x:Key="General_ShowImageTranslate">Показывать кнопку перевода изображения</sys:String>
    <sys:String x:Key="General_ShowImageTranslateDescription">Показывать в главном окне кнопку «Перевод изображения». Программа делает снимок экрана и переводит прямо на изображении</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLines">Направляющие при съёмке экрана</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLinesDescription">Показывать ли направляющие линии при съёмке экрана, чтобы точнее выделить область.</sys:String>
    <sys:String x:Key="General_HideNotifyIcon">Скрыть значок в трее</sys:String>
    <sys:String x:Key="General_ShowScreenshotItemInNotifyIconMenu">Показывать «Перевод скриншота» в меню трея</sys:String>
    <sys:String x:Key="General_ShowImageTranslateItemInNotifyIconMenu">Показывать «Перевод изображения» в меню трея</sys:String>
    <sys:String x:Key="General_ShowOcrItemInNotifyIconMenu">Показывать «Распознавание текста» в меню трея</sys:String>
    <sys:String x:Key="General_ShowQrCodeItemInNotifyIconMenu">Показывать «QR-код» в меню трея</sys:String>
    <sys:String x:Key="General_ColorTheme">Цветовая тема</sys:String>
    <sys:String x:Key="General_ColorThemeDescription">Выберите цветовую тему оформления.</sys:String>
    <sys:String x:Key="General_ColorThemeButtonVisible">Показывать кнопку цветовой темы в главном окне</sys:String>
    <sys:String x:Key="General_HideInputBox">Скрыть поле ввода</sys:String>
    <sys:String x:Key="General_HideInputBoxDescription">Скрывать ли поле ввода.</sys:String>
    <sys:String x:Key="General_HideInputBoxButtonVisible">Показывать кнопку «Скрыть поле ввода» в главном окне</sys:String>
    <sys:String x:Key="General_HideLanguageControl">Скрыть панель выбора языков</sys:String>
    <sys:String x:Key="General_HideLanguageControlDescription">Скрывать ли панель выбора языков вместе с полем ввода.</sys:String>
    <sys:String x:Key="General_ShowMouseSelectionTranslation">Показывать кнопку перевода по выделению мышью</sys:String>
    <sys:String x:Key="General_ShowMouseSelectionTranslationDescription">Показывать в главном окне переключатель перевода по выделению мышью.</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionTranslation">Перевод по выделению мышью</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionTranslationDescription">Копировать и сразу переводить текст, выделенный перетаскиванием или двойным щелчком.</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionIcon">Всплывающий значок после выделения мышью</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionIconDescription">Показывать всплывающий значок после выделения текста перетаскиванием или двойным щелчком и переводить по нажатию на него. Если включены обе возможности, приоритет у немедленного перевода.</sys:String>
    <sys:String x:Key="MouseSelectionIconTranslate">Перевести</sys:String>
    <sys:String x:Key="MouseSelectionTranslationRequiresTopmost">Пока включён перевод по выделению мышью, окно должно быть закреплено поверх всех окон.</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigation">Показывать навигацию по истории</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigationDescription">Показывать ли в главном окне кнопки перехода вперёд и назад по истории переводов.</sys:String>
    <sys:String x:Key="General_ShowOcrButton">Показывать кнопку распознавания текста</sys:String>
    <sys:String x:Key="General_ShowOcrButtonDescription">Показывать кнопку распознавания текста в заголовке главного окна.</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitor">Показывать кнопку слежения за буфером обмена</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitorDescription">Показывать кнопку слежения за буфером обмена в заголовке главного окна.</sys:String>
    <sys:String x:Key="General_MainHeaderConfig">Кнопки в заголовке главного окна</sys:String>
    <sys:String x:Key="General_MainHeaderConfigDescription">Сверху — предпросмотр, снизу — набор кнопок. Перетащите кнопку из набора в предпросмотр, чтобы показать её, и обратно, чтобы скрыть; порядок меняется перетаскиванием внутри предпросмотра.</sys:String>
    <sys:String x:Key="General_MainHeaderPreview">Предпросмотр (заголовок окна)</sys:String>
    <sys:String x:Key="General_MainHeaderPool">Набор кнопок (скрытые)</sys:String>
    <sys:String x:Key="General_MainHeaderShowAll">Показать все</sys:String>
    <sys:String x:Key="General_MainHeaderHideAll">Скрыть все</sys:String>
    <sys:String x:Key="General_ShowCloseButton">Показывать кнопку закрытия</sys:String>
    <sys:String x:Key="General_ShowCloseButtonDescription">Показывать кнопку закрытия справа от кнопки настроек в заголовке главного окна. Работает так же, как клавиша Esc.</sys:String>
    <sys:String x:Key="General_FontSize">Размер шрифта</sys:String>
    <sys:String x:Key="General_FontSizeDescription">Размер шрифта для всех элементов, кроме контекстного меню</sys:String>
    <sys:String x:Key="General_OutputShowingControl">Кнопки в области результата</sys:String>
    <sys:String x:Key="General_ShowPascalCase">Показывать кнопку копирования в PascalCase</sys:String>
    <sys:String x:Key="General_ShowCamelCase">Показывать кнопку копирования в camelCase</sys:String>
    <sys:String x:Key="General_ShowSnakeCase">Показывать кнопку копирования в snake_case</sys:String>
    <sys:String x:Key="General_ShowInsert">Показывать кнопку вставки текста</sys:String>
    <sys:String x:Key="General_ShowBackTranslation">Показывать кнопку обратного перевода</sys:String>
    <sys:String x:Key="General_ShowPrompt">Показывать переключатель промпта</sys:String>
    <sys:String x:Key="General_ShowPromptDescription">Показывать ли в главном окне кнопку переключения промпта для ИИ-сервисов перевода</sys:String>
    <sys:String x:Key="General_FontFamily">Шрифт</sys:String>
    <sys:String x:Key="General_HistoryCount">Количество записей в истории</sys:String>
    <sys:String x:Key="General_CopyAfterTranslation">Копировать после перевода</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationDescription">Работает только для сервисов в режиме «Автоматически»</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationNotAutomatic">Копировать после перевода вне режима «Автоматически»</sys:String>
    <sys:String x:Key="General_CopyAfterOcr">Копировать после распознавания</sys:String>
    <sys:String x:Key="General_CopyAfterOcrDescription">Во всех сценариях распознавания текста автоматически копировать результат.</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslate">Активировать поле ввода после перевода скриншота</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslateDescription">Включено: после перевода скриншота показывать главное окно и ставить курсор в поле ввода. Выключено: если главное окно закреплено поверх всех окон, результат обновляется без перехвата фокуса; незакреплённое окно открывается как обычно.</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSource">Источник CDN для каталога плагинов</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSourceDescription">Выберите CDN для загрузки данных каталога плагинов (у варианта «GitHub напрямую» нет задержки кеша)</sys:String>
    <sys:String x:Key="General_CustomCdnUrl">Свой адрес CDN</sys:String>
    <sys:String x:Key="General_CustomCdnUrlDescription">Укажите свой шаблон адреса CDN; в качестве подстановок используйте {author}, {repo}, {branch}, {path}</sys:String>

    <!--  // PluginMarketCdnSourceType //  -->
    <sys:String x:Key="PluginMarketCdnSourceTypeJsDelivr">jsDelivr CDN (рекомендуется)</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeGitHubRaw">GitHub напрямую</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeCustom">Свой вариант</sys:String>

    <!--  // PluginDownloadProxyType //  -->
    <sys:String x:Key="PluginDownloadProxyTypeGitHub">GitHub напрямую</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyMirror">mirror.ghproxy.com</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyNet">ghproxy.net</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeCustom">Свой вариант</sys:String>

    <!--  // Hotkey Page //  -->
    <sys:String x:Key="GlobalHotkeys">Глобальные горячие клавиши</sys:String>
    <sys:String x:Key="SoftwareHotkeys">Горячие клавиши в программе</sys:String>
    <sys:String x:Key="Hotkey_OpenSTranslate">Открыть STranslate</sys:String>
    <sys:String x:Key="Hotkey_OpenSTranslateDescription">Показать или скрыть главное окно STranslate.</sys:String>
    <sys:String x:Key="Hotkey_InputTranslate">Перевод из поля ввода</sys:String>
    <sys:String x:Key="Hotkey_InputTranslateDescription">Открыть STranslate с очищенным полем ввода для перевода.</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslate">Перевод выделенного текста</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateDescription">Перевести текст, выделенный мышью.</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateIsUseCtrlSameC">Использовать Ctrl+C+C для перевода выделенного текста?</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateTraditional">Обычная горячая клавиша</sys:String>
    <sys:String x:Key="Hotkey_CrosswordTranslateByCtrlSameCDescription">Выделите текст мышью и быстро нажмите Ctrl+C+C, чтобы перевести его.</sys:String>
    <sys:String x:Key="CrosswordTranslateFetchFailed">Не удалось получить выделенный текст — открыто поле ввода для перевода.</sys:String>
    <sys:String x:Key="CrosswordTranslateFetchFailedShowWindow">Не удалось получить выделенный текст — показано главное окно.</sys:String>
