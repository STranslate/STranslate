    <!--  // General Page //  -->
    <sys:String x:Key="TimeoutPlaceholder">Тайм-аут (секунди)</sys:String>
    <sys:String x:Key="SearchFunction">Пошук функцій</sys:String>
    <sys:String x:Key="SearchFunctionToolTip">Ctrl+F — пошук функцій</sys:String>
    <sys:String x:Key="NoResultsFound">Нічого не знайдено</sys:String>
    <sys:String x:Key="Function">Функції</sys:String>
    <sys:String x:Key="Appearance">Зовнішній вигляд</sys:String>
    <sys:String x:Key="AutoTranslateEnabled">Увімкнути автопереклад</sys:String>
    <sys:String x:Key="AutoTranslateDisabled">Вимкнути автопереклад</sys:String>
    <sys:String x:Key="General_AutoStartup">Автозапуск</sys:String>
    <sys:String x:Key="General_AutoStartupDescription">Запускати програму автоматично під час увімкнення комп'ютера.</sys:String>
    <sys:String x:Key="General_StartMode">Режим запуску</sys:String>
    <sys:String x:Key="General_StartModeDescription">Режим «Без запиту UAC» створює завдання в планувальнику, щоб вікно UAC не з'являлося.</sys:String>
    <sys:String x:Key="General_HideOnStartup">Приховувати вікно під час запуску системи</sys:String>
    <sys:String x:Key="General_HideOnStartupDescription">Після запуску STranslate головне вікно ховається в трей.</sys:String>
    <sys:String x:Key="General_HideWhenDeactivated">Автоматично приховувати вікно при втраті фокуса</sys:String>
    <sys:String x:Key="General_WindowPosition">Де відкривати головне вікно</sys:String>
    <sys:String x:Key="General_WindowAlign">Розташування головного вікна на екрані</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatio">Максимальна висота головного вікна (частка екрана)</sys:String>
    <sys:String x:Key="General_MainWindowMaxHeightRatioDescription">Задає максимальну висоту головного вікна в частках робочої області поточного екрана (60%–100%).</sys:String>
    <sys:String x:Key="General_DisableGlobalHotkeys">Вимкнути глобальні гарячі клавіші</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreen">Ігнорувати гарячі клавіші в повноекранному режимі</sys:String>
    <sys:String x:Key="General_IgnoreHotkeysOnFullscreenDescription">Пріоритет нижчий, ніж у налаштування «Вимкнути глобальні гарячі клавіші»; зазвичай потрібно в іграх.</sys:String>
    <sys:String x:Key="General_LanguageDetector">Визначення мови</sys:String>
    <sys:String x:Key="General_LocalDetector">Частка англійських символів для локального визначення</sys:String>
    <sys:String x:Key="General_LocalDetectorDescription">Застосовується лише до режиму «Локальне визначення»: частка англійських символів від загальної кількості символів у китайсько-англійському тексті.</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguage">Мова оригіналу за замовчуванням</sys:String>
    <sys:String x:Key="General_DefaultSourceLanguageDescription">Використовувати цю мову, якщо визначити мову автоматично не вдалося.</sys:String>
    <sys:String x:Key="General_FirstLanguage">Перша мова</sys:String>
    <sys:String x:Key="General_FirstLanguageDescription">Якщо в будь-якому сценарії перекладу мовою перекладу вибрано «Авто», а мова оригіналу інша (зокрема друга мова), перекладати першою мовою.</sys:String>
    <sys:String x:Key="General_SecondLanguage">Друга мова</sys:String>
    <sys:String x:Key="General_SecondLanguageDescription">Якщо в будь-якому сценарії перекладу мовою перекладу вибрано «Авто», а мова оригіналу — перша, перекладати другою мовою.</sys:String>
    <sys:String x:Key="General_HttpTimeout">Тайм-аут</sys:String>
    <sys:String x:Key="General_HttpTimeoutDescription">Тайм-аут мережевого запиту в секундах.</sys:String>
    <sys:String x:Key="General_UseClipboardOutput">Виводити текст через буфер обміну</sys:String>
    <sys:String x:Key="General_UseClipboardOutputDescription">Якщо ввімкнено, текст вставляється з буфера обміну через Ctrl+V; якщо вимкнено — емулюється введення з клавіатури (типово).</sys:String>
    <sys:String x:Key="General_TranslateOnPaste">Перекладати під час вставлення</sys:String>
    <sys:String x:Key="General_TranslateOnPasteDescription">Одразу перекладати текст, вставлений у поле введення.</sys:String>
    <sys:String x:Key="General_AutoTranslate">Автопереклад</sys:String>
    <sys:String x:Key="General_AutoTranslateDescription">Автоматично запускати переклад через заданий час після введення тексту.</sys:String>
    <sys:String x:Key="General_InstantTranslate">Миттєвий переклад</sys:String>
    <sys:String x:Key="General_InstantTranslateDescription">Одразу запускати переклад під час таких дій.</sys:String>
    <sys:String x:Key="General_AutoTranslateButtonVisible">Показувати кнопку автоперекладу в головному вікні</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChanged">Автопереклад після зміни промпту</sys:String>
    <sys:String x:Key="General_AutoTranslateOnPromptChangedDescription">Одразу повторювати переклад після перемикання промпту в ШІ-сервісах перекладу.</sys:String>
    <sys:String x:Key="General_IncrementalClearInput">Очищати поле введення під час накопичувального перекладу</sys:String>
    <sys:String x:Key="General_IncrementalClearInputDescription">Якщо ввімкнено (типово), під час запуску накопичувального перекладу поле введення очищається, але виділені за сеанс фрагменти все одно дописуються. Якщо вимкнено, попередній вміст зберігається, а нові виділення дописуються до нього.</sys:String>
    <sys:String x:Key="General_AutoTranslateDelay">Затримка автоперекладу</sys:String>
    <sys:String x:Key="General_AutoTranslateDelayDescription">Пауза після введення тексту, у мілісекундах.</sys:String>
    <sys:String x:Key="General_LineBreakHandleType">Обробка розривів рядків</sys:String>
    <sys:String x:Key="General_LineBreakHandleTypeDescription" xml:space="preserve">Діє під час перекладу виділеного тексту, перекладу знімка екрана, роботи з буфером обміну та фонового розпізнавання.&#10;Режим «Видаляти зайві розриви рядків» розрахований насамперед на текст із PDF: він прибирає зайві розриви рядків і речень, але може вплинути й на текст з інших джерел.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleType">Обробка роздільників у тексті</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleTypeDescription">Замінює підкреслення або дефіси всередині латинських і цифрових ідентифікаторів на пробіли. Типово вимкнено.</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopes">Область обробки роздільників</sys:String>
    <sys:String x:Key="General_TextSeparatorHandleScopesDescription">Виберіть, за яких способів отримання тексту застосовувати обробку роздільників. Якщо нічого не вибрано, текст залишається без змін.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeout">Тайм-аут отримання тексту</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutDescription">Скільки чекати на появу нового тексту в буфері обміну після емуляції копіювання, у мілісекундах. Щойно текст оновиться, очікування припиняється; для повільних PDF-програм значення варто збільшити.</sys:String>
    <sys:String x:Key="General_SelectedTextFetchTimeoutPlaceholder">500</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTarget">Якщо не вдалося отримати виділений текст</sys:String>
    <sys:String x:Key="General_CrosswordFetchFailedFallbackTargetDescription">Виберіть, що робити, якщо отримати виділений текст не вдалося: перейти до перекладу з поля введення чи лише показати головне вікно.</sys:String>
    <sys:String x:Key="General_ImageQuality">Якість зображення</sys:String>
    <sys:String x:Key="General_ImageQualityDescription">Якість обробки зображень. Онлайн-сервіси розпізнавання тексту можуть обмежувати розмір зображення.</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunction">Подвійне клацання по значку в треї</sys:String>
    <sys:String x:Key="General_DoubleClickTrayFunctionDescription">Будь-яка дія, крім «Немає», вимикає показ і приховування головного вікна одинарним клацанням по значку в треї.</sys:String>
    <sys:String x:Key="General_Language">Мова інтерфейсу</sys:String>
    <sys:String x:Key="General_ScreenshotTranslate">Переклад знімка екрана</sys:String>
    <sys:String x:Key="General_ImageTranslate">Переклад зображення</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslate">Показувати кнопку перекладу знімка екрана</sys:String>
    <sys:String x:Key="General_ShowScreenshotTranslateDescription">Показувати в головному вікні кнопку «Переклад знімка екрана». Програма робить знімок екрана, розпізнає текст, вставляє його в поле введення й перекладає</sys:String>
    <sys:String x:Key="General_ShowImageTranslate">Показувати кнопку перекладу зображення</sys:String>
    <sys:String x:Key="General_ShowImageTranslateDescription">Показувати в головному вікні кнопку «Переклад зображення». Програма робить знімок екрана й перекладає просто на зображенні</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLines">Напрямні під час знімання екрана</sys:String>
    <sys:String x:Key="General_ShowScreenshotAuxiliaryLinesDescription">Чи показувати напрямні лінії під час знімання екрана, щоб точніше виділити область.</sys:String>
    <sys:String x:Key="General_HideNotifyIcon">Приховати значок у треї</sys:String>
    <sys:String x:Key="General_ShowScreenshotItemInNotifyIconMenu">Показувати «Переклад знімка екрана» в меню трея</sys:String>
    <sys:String x:Key="General_ShowImageTranslateItemInNotifyIconMenu">Показувати «Переклад зображення» в меню трея</sys:String>
    <sys:String x:Key="General_ShowOcrItemInNotifyIconMenu">Показувати «Розпізнавання тексту» в меню трея</sys:String>
    <sys:String x:Key="General_ShowQrCodeItemInNotifyIconMenu">Показувати «QR-код» у меню трея</sys:String>
    <sys:String x:Key="General_ColorTheme">Кольорова тема</sys:String>
    <sys:String x:Key="General_ColorThemeDescription">Виберіть кольорову тему оформлення.</sys:String>
    <sys:String x:Key="General_ColorThemeButtonVisible">Показувати кнопку кольорової теми в головному вікні</sys:String>
    <sys:String x:Key="General_HideInputBox">Приховати поле введення</sys:String>
    <sys:String x:Key="General_HideInputBoxDescription">Чи приховувати поле введення.</sys:String>
    <sys:String x:Key="General_HideInputBoxButtonVisible">Показувати кнопку «Приховати поле введення» в головному вікні</sys:String>
    <sys:String x:Key="General_HideLanguageControl">Приховати панель вибору мов</sys:String>
    <sys:String x:Key="General_HideLanguageControlDescription">Чи приховувати панель вибору мов разом із полем введення.</sys:String>
    <sys:String x:Key="General_ShowMouseSelectionTranslation">Показувати кнопку перекладу за виділенням мишею</sys:String>
    <sys:String x:Key="General_ShowMouseSelectionTranslationDescription">Показувати в головному вікні перемикач перекладу за виділенням мишею.</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionTranslation">Переклад за виділенням мишею</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionTranslationDescription">Копіювати й одразу перекладати текст, виділений перетягуванням або подвійним клацанням.</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionIcon">Спливний значок після виділення мишею</sys:String>
    <sys:String x:Key="General_EnableMouseSelectionIconDescription">Показувати спливний значок після виділення тексту перетягуванням або подвійним клацанням і перекладати після натискання на нього. Якщо ввімкнено обидві можливості, пріоритет має негайний переклад.</sys:String>
    <sys:String x:Key="MouseSelectionIconTranslate">Перекласти</sys:String>
    <sys:String x:Key="MouseSelectionTranslationRequiresTopmost">Поки ввімкнено переклад за виділенням мишею, вікно має бути закріплене поверх усіх вікон.</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigation">Показувати навігацію історією</sys:String>
    <sys:String x:Key="General_ShowHistoryNavigationDescription">Чи показувати в головному вікні кнопки переходу вперед і назад історією перекладів.</sys:String>
    <sys:String x:Key="General_ShowOcrButton">Показувати кнопку розпізнавання тексту</sys:String>
    <sys:String x:Key="General_ShowOcrButtonDescription">Показувати кнопку розпізнавання тексту в заголовку головного вікна.</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitor">Показувати кнопку стеження за буфером обміну</sys:String>
    <sys:String x:Key="General_ShowClipboardMonitorDescription">Показувати кнопку стеження за буфером обміну в заголовку головного вікна.</sys:String>
    <sys:String x:Key="General_MainHeaderConfig">Кнопки в заголовку головного вікна</sys:String>
    <sys:String x:Key="General_MainHeaderConfigDescription">Згори — попередній перегляд, знизу — набір кнопок. Перетягніть кнопку з набору до попереднього перегляду, щоб показати її, і назад, щоб приховати; порядок змінюється перетягуванням усередині попереднього перегляду.</sys:String>
    <sys:String x:Key="General_MainHeaderPreview">Попередній перегляд (заголовок вікна)</sys:String>
    <sys:String x:Key="General_MainHeaderPool">Набір кнопок (приховані)</sys:String>
    <sys:String x:Key="General_MainHeaderShowAll">Показати всі</sys:String>
    <sys:String x:Key="General_MainHeaderHideAll">Приховати всі</sys:String>
    <sys:String x:Key="General_ShowCloseButton">Показувати кнопку закриття</sys:String>
    <sys:String x:Key="General_ShowCloseButtonDescription">Показувати кнопку закриття праворуч від кнопки налаштувань у заголовку головного вікна. Працює так само, як клавіша Esc.</sys:String>
    <sys:String x:Key="General_FontSize">Розмір шрифту</sys:String>
    <sys:String x:Key="General_FontSizeDescription">Розмір шрифту для всіх елементів, крім контекстного меню</sys:String>
    <sys:String x:Key="General_OutputShowingControl">Кнопки в області результату</sys:String>
    <sys:String x:Key="General_ShowPascalCase">Показувати кнопку копіювання в PascalCase</sys:String>
    <sys:String x:Key="General_ShowCamelCase">Показувати кнопку копіювання в camelCase</sys:String>
    <sys:String x:Key="General_ShowSnakeCase">Показувати кнопку копіювання в snake_case</sys:String>
    <sys:String x:Key="General_ShowInsert">Показувати кнопку вставлення тексту</sys:String>
    <sys:String x:Key="General_ShowBackTranslation">Показувати кнопку зворотного перекладу</sys:String>
    <sys:String x:Key="General_ShowPrompt">Показувати перемикач промпту</sys:String>
    <sys:String x:Key="General_ShowPromptDescription">Чи показувати в головному вікні кнопку перемикання промпту для ШІ-сервісів перекладу</sys:String>
    <sys:String x:Key="General_FontFamily">Шрифт</sys:String>
    <sys:String x:Key="General_HistoryCount">Кількість записів в історії</sys:String>
    <sys:String x:Key="General_CopyAfterTranslation">Копіювати після перекладу</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationDescription">Працює лише для сервісів у режимі «Автоматично»</sys:String>
    <sys:String x:Key="General_CopyAfterTranslationNotAutomatic">Копіювати після перекладу поза режимом «Автоматично»</sys:String>
    <sys:String x:Key="General_CopyAfterOcr">Копіювати після розпізнавання</sys:String>
    <sys:String x:Key="General_CopyAfterOcrDescription">В усіх сценаріях розпізнавання тексту автоматично копіювати результат.</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslate">Активувати поле введення після перекладу знімка екрана</sys:String>
    <sys:String x:Key="General_FocusInputAfterScreenshotTranslateDescription">Увімкнено: після перекладу знімка екрана показувати головне вікно й ставити курсор у поле введення. Вимкнено: якщо головне вікно закріплене поверх усіх вікон, результат оновлюється без перехоплення фокуса; незакріплене вікно відкривається як зазвичай.</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSource">Джерело CDN для каталогу плагінів</sys:String>
    <sys:String x:Key="General_PluginMarketCdnSourceDescription">Виберіть CDN для завантаження даних каталогу плагінів (у варіанта «GitHub напряму» немає затримки кешу)</sys:String>
    <sys:String x:Key="General_CustomCdnUrl">Власна адреса CDN</sys:String>
    <sys:String x:Key="General_CustomCdnUrlDescription">Укажіть власний шаблон адреси CDN; як підстановки використовуйте {author}, {repo}, {branch}, {path}</sys:String>

    <!--  // PluginMarketCdnSourceType //  -->
    <sys:String x:Key="PluginMarketCdnSourceTypeJsDelivr">jsDelivr CDN (рекомендовано)</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeGitHubRaw">GitHub напряму</sys:String>
    <sys:String x:Key="PluginMarketCdnSourceTypeCustom">Власний варіант</sys:String>

    <!--  // PluginDownloadProxyType //  -->
    <sys:String x:Key="PluginDownloadProxyTypeGitHub">GitHub напряму</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyMirror">mirror.ghproxy.com</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeGhProxyNet">ghproxy.net</sys:String>
    <sys:String x:Key="PluginDownloadProxyTypeCustom">Власний варіант</sys:String>

